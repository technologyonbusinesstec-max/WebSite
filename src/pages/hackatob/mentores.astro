---
// src/pages/hackatob/mentores.astro
// Página con todos los mentores y jurados del HackaToB: misma estructura que /speakers del ToB
// (encabezado y, por grupo, tarjetas SpeakerLinearCards que se abren con la foto, el puesto, la bio y sus redes).
// Las personas se editan en src/components/hackatob/mentores.ts.
import HackaLayout from '../../layouts/HackaLayout.astro';
import { SpeakerLinearCards } from '../../components/ui/linear-card';
import { mentorCards, juradoCards } from '../../components/hackatob/mentores';
---

<HackaLayout
  title="Mentores y jurados – HackaToB 2026"
  description="Mentores de la industria que acompañan a los equipos y jurado del Demo Day del HackaToB 2026."
  basePath="/hackatob"
  backHref="/hackatob"
  backLabel="Volver al HackaToB"
>
  <section class="speakers-page-hero">
    <div class="speakers-hero-content">
      <span class="speakers-eyebrow" data-i18n="hack_mt_label">Mentores y jurados</span>
      <h1 class="speakers-page-title" data-i18n="hack_mt_title">Personas de la industria a tu lado.</h1>
      <p class="speakers-page-desc" data-i18n="hack_mt_desc">
        Durante el HackaToB, mentores de la industria acompañan a los equipos para destrabar su proyecto, y un jurado evalúa los proyectos en el Demo Day.
      </p>
    </div>
  </section>

  <section class="mt-section">
    <div class="mt-section-header">
      <h2 class="mt-category-title" data-i18n="hack_mt_group">Mentores</h2>
      <div class="mt-divider"></div>
    </div>

    <SpeakerLinearCards client:load items={mentorCards} />

    <div class="mt-section-header mt-section-header--next">
      <h2 class="mt-category-title" data-i18n="hack_jd_group">Jurados</h2>
      <div class="mt-divider"></div>
    </div>

    <SpeakerLinearCards client:load items={juradoCards} />
  </section>
</HackaLayout>

<style>
  .speakers-page-hero,
  .mt-section {
    position: relative;
    z-index: 1;
  }

  .mt-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 24px 100px;
  }

  .mt-section-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 48px;
  }

  .mt-section-header--next {
    margin-top: 90px;
  }

  .mt-category-title {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    white-space: nowrap;
    color: #fff;
  }

  .mt-divider {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.18), transparent);
  }
</style>
