  <script is:inline>
    const dayButtons = [...document.querySelectorAll(".day-toggle")];
    const dayContents = [...document.querySelectorAll(".day-content")];
    function closeBlocks() {
      document.querySelectorAll(".block-button").forEach(button => button.setAttribute("aria-pressed", "false"));
      document.querySelectorAll(".session-panel").forEach(panel => panel.classList.remove("is-open"));
    }
    function reset() {
      closeBlocks();
      dayButtons.forEach(button => button.setAttribute("aria-pressed", "false"));
      dayContents.forEach(content => content.classList.remove("is-open"));
    }
    dayButtons.forEach(button => button.addEventListener("click", () => {
      reset();
      button.setAttribute("aria-pressed", "true");
      document.getElementById(button.dataset.day).classList.add("is-open");
    }));
    document.querySelectorAll(".block-button").forEach(button => button.addEventListener("click", () => {
      closeBlocks();
      button.setAttribute("aria-pressed", "true");
      document.getElementById(button.dataset.panel).classList.add("is-open");
    }));
    document.getElementById("reset").addEventListener("click", reset);
  </script>
