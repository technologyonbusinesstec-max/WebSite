---
import Layout from '../layouts/Layout.astro';
import { SpeakerLinearCards } from '../components/ui/linear-card';

const speakersList = [
  { foto: "/imagenes/speakers/speaker01.webp",  nombre: "Pedro Gutiérrez",    puesto: "Avify",            descripcion: "Compartirá el camino de construir una startup de 0 a 1M.",                             linkedin: "https://www.linkedin.com/in/peter-gg/" },
  { foto: "/imagenes/speakers/speaker02.webp",  nombre: "Tamara Sancho",      puesto: "P&G",              descripcion: "Transformando el miedo en una herramienta de crecimiento profesional.",                linkedin: "https://www.linkedin.com/in/tamarajudit/" },
  { foto: "/imagenes/speakers/speaker03.webp",  nombre: "Pilar Sánchez",      puesto: "Avify",            descripcion: "Líder de la industria compartiendo su visión en resiliencia.",                         linkedin: "" },
  { foto: "/imagenes/speakers/speaker04.webp",  nombre: "Wendy Badilla",      puesto: "Microsoft",        descripcion: "Experta de Microsoft enfocada en empoderamiento femenino en STEM.",                     linkedin: "https://www.linkedin.com/in/wendy-badilla-225630a0/" },
  { foto: "/imagenes/speakers/speaker05.webp",  nombre: "Aaron Omodeo",       puesto: "Doji Club",        descripcion: "Especialista en finanzas prácticas y toma de decisiones de inversión.",                 linkedin: "https://www.linkedin.com/in/aaron-omodeo/" },
  { foto: "/imagenes/speakers/speaker12.webp",  nombre: "Diego Loud",         puesto: "Loud",             descripcion: "Estrategias de mercadeo para conectar con audiencias saturadas.",                       linkedin: "https://www.linkedin.com/in/diegomartinezj/" },
  { foto: "/imagenes/speakers/speaker07.webp",  nombre: "María José Artavia", puesto: "Directora ATI",    descripcion: "Directora dando apertura oficial a TOB-ATI 2026.",                                      linkedin: "" },
  { foto: "/imagenes/speakers/speaker08.webp",  nombre: "Alek Castillo",      puesto: "Lyfter",           descripcion: "Experta en liderazgo adaptativo en entornos de cambio acelerado.",                      linkedin: "" },
  { foto: "/imagenes/speakers/speaker09.webp",  nombre: "Alejandro Hidalgo",  puesto: "P&G",              descripcion: "Aplicación de metodologías ágiles para entregar valor más rápido.",                     linkedin: "" },
  { foto: "/imagenes/speakers/speaker10.webp",  nombre: "Gerardo Nájera",     puesto: "Sefisa",           descripcion: "Estrategias de ciberseguridad para proteger información vital.",                         linkedin: "" },
  { foto: "/imagenes/speakers/speaker11.webp",  nombre: "Karla Córdoba",      puesto: "Aso Blockchain CR",descripcion: "Aplicaciones reales de la confianza digital más allá de cripto.",                       linkedin: "" },
  { foto: "/imagenes/speakers/speaker13.webp",  nombre: "Ronald Arce",        puesto: "INCAE",            descripcion: "Cómo la IA está redefiniendo los modelos de negocio.",                                  linkedin: "" },
];

const culturalList = [
  { foto: "/imagenes/speakers/actividadCultural01.webp", nombre: "Rubén Monarca", descripcion: "Presentación cultural y artística en vivo.",    linkedin: "" },
  { foto: "/imagenes/speakers/actividadCultural02.webp", nombre: "Nestor Morales", descripcion: "Presentación musical con Bandati.",             linkedin: "" },
  { foto: "/imagenes/speakers/actividadCultural03.webp", nombre: "Pedro Leiva",    descripcion: "Presentación musical con Bandati.",             linkedin: "" },
  { foto: "/imagenes/speakers/actividadCultural04.webp", nombre: "Melody Coto",    descripcion: "Expresión artística y dinamismo musical.",      linkedin: "" },
];

const talkItems = speakersList.map((s, i) => {
  const id = String(i + 1).padStart(2, "0");
  return {
    id: i + 1,
    foto: s.foto,
    nameKey: `speaker_${id}_name`,
    roleKey: `speaker_${id}_role`,
    bioKey: `speaker_${id}_bio`,
    name: s.nombre,
    role: s.puesto,
    bio: s.descripcion,
    linkedin: s.linkedin,
    instagram: "",
  };
});

const culturalItems = culturalList.map((a, i) => {
  const id = String(i + 18).padStart(2, "0");
  return {
    id: i + 18,
    foto: a.foto,
    nameKey: `speaker_${id}_name`,
    roleKey: `speaker_${id}_role`,
    bioKey: `speaker_${id}_bio`,
    name: a.nombre,
    role: "Actividad Cultural",
    bio: a.descripcion,
    linkedin: a.linkedin,
    instagram: "",
  };
});
---

<Layout>
  <div class="speakers-page-bg" aria-hidden="true"></div>

  <section class="speakers-page-hero">
    <div class="speakers-hero-overlay"></div>
    <div class="speakers-hero-content">
      <span class="speakers-eyebrow" data-i18n="speak_label">Expositores</span>
      <h1 class="speakers-page-title" data-i18n="speak_title">Las grandes ideas comienzan con una conversación.</h1>
      <p class="speakers-page-desc" data-i18n="speak_desc">
        En el ToB tendrás la oportunidad de escuchar a expertos de la industria, descubrir tecnologías emergentes y conectar con personas que comparten tu pasión por la innovación, los negocios y el futuro digital.
      </p>
    </div>
  </section>

  <section class="spk-section">
    <div class="spk-section-header">
      <h2 class="spk-category-title" data-i18n="spk_cat_talks">Conferencistas &amp; Paneles</h2>
      <div class="spk-divider"></div>
    </div>

    <SpeakerLinearCards client:load items={talkItems} />

    <div class="spk-section-header" style="margin-top: 90px;">
      <h2 class="spk-category-title" data-i18n="spk_cat_cultural">Actos Culturales &amp; Artistas</h2>
      <div class="spk-divider"></div>
    </div>

    <SpeakerLinearCards client:load items={culturalItems} />
  </section>
</Layout>

<style>
  .speakers-page-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #08090a;
    z-index: 0;
    pointer-events: none;
  }

  .speakers-page-hero,
  .spk-section {
    position: relative;
    z-index: 1;
  }

  :global(.site-footer) {
    position: relative;
    z-index: 2;
    background: #010204;
  }

  .spk-section {
    padding: 20px 24px 100px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .spk-section-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 48px;
  }

  .spk-category-title {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    margin: 0;
  }

  .spk-divider {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.18), transparent);
  }
</style>
