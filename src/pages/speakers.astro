---
import Layout from '../layouts/Layout.astro';
import { SpeakerLinearCards } from '../components/ui/linear-card';
import { personas, sesionesDe, type PersonaTipo } from '../data/tob2026';

// Las claves ppl_<id>_* traducen rol y bio; el nombre no se traduce.
const cardsDe = (tipo: PersonaTipo, offset: number) =>
  personas
    .filter((p) => p.tipo === tipo)
    .map((p, i) => ({
      id: offset + i,
      foto: p.foto,
      nameKey: `ppl_${p.id}_name`,
      roleKey: `ppl_${p.id}_role`,
      bioKey: `ppl_${p.id}_bio`,
      name: p.nombre,
      role: p.rol,
      bio: p.bio,
      linkedin: p.linkedin ?? "",
      instagram: p.instagram ?? "",
      talks: sesionesDe(p.id).map(({ dia, sesion }) => ({
        titleKey: `prg_${sesion.key}_title`,
        title: sesion.titulo,
        dayKey: dia.fechaKey,
        day: dia.fecha,
        time: sesion.hora.split(" — ")[0],
      })),
    }));

const talkItems = cardsDe("speaker", 1);
const culturalItems = cardsDe("cultural", 100);
---

<Layout>
  <div class="speakers-page-bg" aria-hidden="true"></div>

  <section class="speakers-page-hero">
    <div class="speakers-hero-overlay"></div>
    <div class="speakers-hero-content">
      <span class="speakers-eyebrow" data-i18n="speak_label">Expositores</span>
      <h1 class="speakers-page-title" data-i18n="speak_title">Las grandes ideas comienzan con una conversación.</h1>
      <p class="speakers-page-desc" data-i18n="speak_desc">
        En el ToB tendrás la oportunidad de escuchar a expertos de la industria, descubrir tecnologías emergentes y conectar con personas que comparten tu pasión por la innovación, los negocios y el futuro digital.
      </p>
    </div>
  </section>

  <section class="spk-section">
    <div class="spk-section-header">
      <h2 class="spk-category-title" data-i18n="spk_cat_talks">Conferencistas &amp; Paneles</h2>
      <div class="spk-divider"></div>
    </div>

    <SpeakerLinearCards client:load items={talkItems} />

    <div class="spk-section-header" style="margin-top: 90px;">
      <h2 class="spk-category-title" data-i18n="spk_cat_cultural">Actos Culturales &amp; Artistas</h2>
      <div class="spk-divider"></div>
    </div>

    <SpeakerLinearCards client:load items={culturalItems} />
  </section>
</Layout>

<style>
  .speakers-page-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #08090a;
    z-index: 0;
    pointer-events: none;
  }

  .speakers-page-hero,
  .spk-section {
    position: relative;
    z-index: 1;
  }

  :global(.site-footer) {
    position: relative;
    z-index: 2;
    background: #010204;
  }

  .spk-section {
    padding: 20px 24px 100px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .spk-section-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 48px;
  }

  .spk-category-title {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    margin: 0;
  }

  .spk-divider {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,0.18), transparent);
  }
</style>
