---
import Layout from '../layouts/Layout.astro';

const speakersList = [
  { foto: "/imagenes/speakers/speaker01.webp",  nombre: "Pedro Gutiérrez",    puesto: "Avify",            descripcion: "Compartirá el camino de construir una startup de 0 a 1M.",                             linkedin: "https://www.linkedin.com/in/peter-gg/" },
  { foto: "/imagenes/speakers/speaker02.webp",  nombre: "Tamara Sancho",      puesto: "P&G",              descripcion: "Transformando el miedo en una herramienta de crecimiento profesional.",                linkedin: "https://www.linkedin.com/in/tamarajudit/" },
  { foto: "/imagenes/speakers/speaker03.webp",  nombre: "Pilar Sánchez",      puesto: "Avify",            descripcion: "Líder de la industria compartiendo su visión en resiliencia.",                         linkedin: "" },
  { foto: "/imagenes/speakers/speaker04.webp",  nombre: "Wendy Badilla",      puesto: "Microsoft",        descripcion: "Experta de Microsoft enfocada en empoderamiento femenino en STEM.",                     linkedin: "https://www.linkedin.com/in/wendy-badilla-225630a0/" },
  { foto: "/imagenes/speakers/speaker05.webp",  nombre: "Aaron Omodeo",       puesto: "Doji Club",        descripcion: "Especialista en finanzas prácticas y toma de decisiones de inversión.",                 linkedin: "https://www.linkedin.com/in/aaron-omodeo/" },
  { foto: "/imagenes/speakers/speaker12.webp",  nombre: "Diego Loud",         puesto: "Loud",             descripcion: "Estrategias de mercadeo para conectar con audiencias saturadas.",                       linkedin: "https://www.linkedin.com/in/diegomartinezj/" },
  { foto: "/imagenes/speakers/speaker07.webp",  nombre: "María José Artavia", puesto: "Directora ATI",    descripcion: "Directora dando apertura oficial a TOB-ATI 2026.",                                      linkedin: "" },
  { foto: "/imagenes/speakers/speaker08.webp",  nombre: "Alek Castillo",      puesto: "Lyfter",           descripcion: "Experta en liderazgo adaptativo en entornos de cambio acelerado.",                      linkedin: "" },
  { foto: "/imagenes/speakers/speaker09.webp",  nombre: "Alejandro Hidalgo",  puesto: "P&G",              descripcion: "Aplicación de metodologías ágiles para entregar valor más rápido.",                     linkedin: "" },
  { foto: "/imagenes/speakers/speaker10.webp",  nombre: "Gerardo Nájera",     puesto: "Sefisa",           descripcion: "Estrategias de ciberseguridad para proteger información vital.",                         linkedin: "" },
  { foto: "/imagenes/speakers/speaker11.webp",  nombre: "Karla Córdoba",      puesto: "Aso Blockchain CR",descripcion: "Aplicaciones reales de la confianza digital más allá de cripto.",                       linkedin: "" },
  { foto: "/imagenes/speakers/speaker13.webp",  nombre: "Ronald Arce",        puesto: "INCAE",            descripcion: "Cómo la IA está redefiniendo los modelos de negocio.",                                  linkedin: "" },
];

const culturalList = [
  { foto: "/imagenes/speakers/actividadCultural01.webp", nombre: "Rubén Monarca", descripcion: "Presentación cultural y artística en vivo.",    linkedin: "" },
  { foto: "/imagenes/speakers/actividadCultural02.webp", nombre: "Nestor Morales", descripcion: "Presentación musical con Bandati.",             linkedin: "" },
  { foto: "/imagenes/speakers/actividadCultural03.webp", nombre: "Pedro Leiva",    descripcion: "Presentación musical con Bandati.",             linkedin: "" },
  { foto: "/imagenes/speakers/actividadCultural04.webp", nombre: "Melody Coto",    descripcion: "Expresión artística y dinamismo musical.",      linkedin: "" },
];
---

<Layout>
  <!-- ── FONDO ESPECÍFICO DE SPEAKERS ──────────────────────────── -->
  <div class="speakers-page-bg" aria-hidden="true"></div>

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="speakers-page-hero">
    <div class="speakers-hero-overlay"></div>
    <div class="speakers-hero-content">
      <span class="speakers-eyebrow">Expositores</span>
      <h1 class="speakers-page-title">Las grandes ideas comienzan con una conversación.</h1>
      <p class="speakers-page-desc">
        En el ToB tendrás la oportunidad de escuchar a expertos de la industria, descubrir tecnologías emergentes y conectar con personas que comparten tu pasión por la innovación, los negocios y el futuro digital.
      </p>
    </div>
  </section>

  <!-- ── CONFERENCISTAS ─────────────────────────────────────────── -->
  <section class="spk-section">
    <div class="spk-section-header">
      <h2 class="spk-category-title">Conferencistas &amp; Paneles</h2>
      <div class="spk-divider"></div>
    </div>

    <div class="spk-grid">
      {speakersList.map((s) => (
        <button class="spk-card"
          data-nombre={s.nombre}
          data-puesto={s.puesto}
          data-foto={s.foto}
          data-desc={s.descripcion}
          data-linkedin={s.linkedin}>
          <div class="spk-avatar-wrap">
            <img src={s.foto} alt={s.nombre} class="spk-avatar" loading="lazy" decoding="async" width="200" height="200" />
          </div>
          <h3 class="spk-name">{s.nombre}</h3>
          <p class="spk-role">{s.puesto}</p>
        </button>
      ))}
    </div>

    <!-- ── CULTURALES ── -->
    <div class="spk-section-header" style="margin-top: 90px;">
      <h2 class="spk-category-title">Actos Culturales &amp; Artistas</h2>
      <div class="spk-divider"></div>
    </div>

    <div class="spk-grid">
      {culturalList.map((a) => (
        <button class="spk-card"
          data-nombre={a.nombre}
          data-puesto="Actividad Cultural"
          data-foto={a.foto}
          data-desc={a.descripcion}
          data-linkedin={a.linkedin}>
          <div class="spk-avatar-wrap">
            <img src={a.foto} alt={a.nombre} class="spk-avatar" loading="lazy" decoding="async" width="200" height="200" />
          </div>
          <h3 class="spk-name">{a.nombre}</h3>
          <p class="spk-role">Actividad Cultural</p>
        </button>
      ))}
    </div>
  </section>




  <!-- ── MODAL ──────────────────────────────────────────────────── -->
  <div class="spk-modal-overlay" id="spkModal" role="dialog" aria-modal="true" aria-labelledby="spkModalName">
    <div class="spk-modal">
      <button class="spk-modal-close" id="spkModalClose" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <div class="spk-modal-photo-wrap">
        <img src="" alt="" class="spk-modal-photo" id="spkModalImg" width="160" height="160" />
      </div>

      <h3 class="spk-modal-name" id="spkModalName"></h3>
      <p class="spk-modal-role" id="spkModalRole"></p>
      <p class="spk-modal-desc" id="spkModalDesc"></p>

      <a href="#" class="spk-modal-linkedin" id="spkModalLinkedin" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        Ver en LinkedIn
      </a>
    </div>
  </div>
</Layout>

<style>
  /* ── Fondo de Speakers ── */
  .speakers-page-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(10, 15, 25, 0.75), rgba(10, 15, 25, 0.88)),
      url('/imagenes/speakers/FondoSpeakers.webp');
    background-size: cover;
    background-position: center;
    z-index: 0;
    pointer-events: none;
  }

  .speakers-page-hero,
  .spk-section {
    position: relative;
    z-index: 1;
  }

  :global(.site-footer) {
    position: relative;
    z-index: 2;
    background: #010204;
  }

  /* ── Sección ── */
  .spk-section {
    padding: 20px 24px 100px;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Header de categoría ── */
  .spk-section-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 56px;
  }

  .spk-category-title {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    margin: 0;
  }

  .spk-divider {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(0,212,255,0.5), transparent);
  }

  /* ── Grid: 3 columnas fijas ── */
  .spk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px 40px;
    justify-items: center;
  }

  /* ── Tarjeta ── */
  .spk-card {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: inherit;
    font-family: inherit;
  }

  .spk-card:focus-visible .spk-avatar-wrap {
    outline: 3px solid var(--color-cyan, #00d4ff);
    outline-offset: 6px;
  }

  /* ── Avatar con borde cyan glowing ── */
  .spk-avatar-wrap {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border: none;
    box-shadow: 0 8px 28px rgba(0,0,0,0.45);
    overflow: hidden;
    margin-bottom: 18px;
    will-change: transform;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .spk-card:hover .spk-avatar-wrap {
    transform: scale(1.06);
    box-shadow:
      0 0 0 3px rgba(0, 212, 255, 0.0),
      0 0 20px rgba(0, 212, 255, 0.7),
      0 0 50px rgba(0, 212, 255, 0.35),
      0 0 80px rgba(0, 212, 255, 0.15);
  }

  .spk-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .spk-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 5px;
    line-height: 1.3;
    text-shadow: 0 2px 6px rgba(0,0,0,0.5);
  }

  .spk-role {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.62);
    margin: 0;
  }

  /* ── Modal overlay ── */
  .spk-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    opacity: 0;
    visibility: hidden;
    will-change: opacity;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding: 20px;
  }

  .spk-modal-overlay.visible {
    opacity: 1;
    visibility: visible;
  }

  /* ── Modal card ── */
  .spk-modal {
    background: #131722;
    border: 1px solid rgba(0,212,255,0.15);
    border-radius: 22px;
    padding: 48px 36px 40px;
    max-width: 400px;
    width: 100%;
    text-align: center;
    position: relative;
    will-change: transform;
    transform: scale(0.86) translateY(16px);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    box-shadow:
      0 28px 70px rgba(0,0,0,0.7),
      0 0 0 1px rgba(0,212,255,0.08),
      0 0 40px rgba(0,212,255,0.06);
  }

  .spk-modal-overlay.visible .spk-modal {
    transform: scale(1) translateY(0);
  }

  /* Cerrar */
  .spk-modal-close {
    position: absolute;
    top: 14px; right: 14px;
    background: rgba(255,255,255,0.07);
    border: none;
    border-radius: 50%;
    width: 36px; height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s;
  }
  .spk-modal-close svg { width: 16px; height: 16px; }
  .spk-modal-close:hover { background: rgba(255,255,255,0.16); }

  /* Foto modal con borde cyan glowing */
  .spk-modal-photo-wrap {
    width: 150px; height: 150px;
    border-radius: 50%;
    border: 3px solid rgba(0,212,255,0.8);
    box-shadow:
      0 0 18px rgba(0,212,255,0.45),
      0 0 50px rgba(0,212,255,0.15);
    overflow: hidden;
    margin: 0 auto 20px;
  }

  .spk-modal-photo {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .spk-modal-name {
    font-size: 1.55rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 6px;
  }

  .spk-modal-role {
    font-size: 0.88rem;
    color: var(--color-cyan, #00d4ff);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .spk-modal-desc {
    font-size: 0.96rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.65;
    margin: 0 0 24px;
    font-style: italic;
  }

  /* Botón LinkedIn */
  .spk-modal-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: #0a66c2;
    color: #fff;
    font-weight: 600;
    font-size: 0.92rem;
    padding: 11px 24px;
    border-radius: 50px;
    text-decoration: none;
    will-change: transform;
    transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
    box-shadow: 0 4px 16px rgba(10,102,194,0.38);
  }

  .spk-modal-linkedin svg {
    width: 18px; height: 18px;
    fill: #fff;
    flex-shrink: 0;
  }

  .spk-modal-linkedin:hover {
    background: #0854a0;
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(10,102,194,0.5);
  }

  .spk-modal-linkedin.hidden {
    display: none;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .spk-grid { grid-template-columns: repeat(2, 1fr); gap: 48px 24px; }
    .spk-avatar-wrap { width: 200px; height: 200px; }
  }

  @media (max-width: 560px) {
    .spk-grid { grid-template-columns: repeat(2, 1fr); gap: 32px 12px; }
    .spk-avatar-wrap { width: 40vw; height: 40vw; max-width: 180px; max-height: 180px; }
    .spk-modal { padding: 40px 20px 32px; }
    .spk-name { font-size: 1rem; }
  }

  @media (max-width: 380px) {
    .spk-grid { grid-template-columns: 1fr; }
    .spk-avatar-wrap { width: 65vw; height: 65vw; }
  }
</style>

<script>
  const modal      = document.getElementById("spkModal")!;
  const modalClose = document.getElementById("spkModalClose")!;
  const modalImg   = document.getElementById("spkModalImg")  as HTMLImageElement;
  const modalName  = document.getElementById("spkModalName")!;
  const modalRole  = document.getElementById("spkModalRole")!;
  const modalDesc  = document.getElementById("spkModalDesc")!;
  const modalLI    = document.getElementById("spkModalLinkedin") as HTMLAnchorElement;

  function openModal(card: HTMLElement) {
    const { nombre, puesto, foto, desc, linkedin } = card.dataset;
    if (!nombre) return;

    modalImg.src  = foto  ?? "";
    modalImg.alt  = nombre;
    modalName.textContent = nombre;
    modalRole.textContent = puesto ?? "";
    modalDesc.textContent = desc   ?? "";

    if (linkedin) {
      modalLI.href = linkedin;
      modalLI.classList.remove("hidden");
    } else {
      modalLI.classList.add("hidden");
    }

    modal.classList.add("visible");
    document.body.style.overflow = "hidden";
    modalClose.focus();
  }

  function closeModal() {
    modal.classList.remove("visible");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const card = (e.target as Element).closest<HTMLElement>(".spk-card");
    if (card) { openModal(card); return; }
    if (e.target === modal) closeModal();
  });

  modalClose.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });
</script>
