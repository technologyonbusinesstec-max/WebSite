---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ── FONDO ESPECÍFICO DEL PROGRAMA ────────────────────────── -->
  <div class="programa-page-bg" aria-hidden="true"></div>

  <!-- ── HERO DEL PROGRAMA ──────────────────────────────────────── -->
  <header class="programa-hero">
    <div class="programa-hero-overlay"></div>
    <div class="programa-hero-content">
      <div class="programa-hero-text">
        <h1 class="programa-title" data-i18n="prog_hero_title">Programa del <span class="text-cyan">Evento</span></h1>
        <p class="programa-slogan" data-i18n="prog_hero_slogan">
          Dos días de conferencias, talleres y networking con los líderes de la industria tecnológica.
        </p>
        <div class="programa-dates">
          <div class="date-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span data-i18n="prog_date1">Miércoles 4 de noviembre, 2026</span>
          </div>
          <span class="date-separator">&mdash;</span>
          <div class="date-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span data-i18n="prog_date2">Jueves 5 de noviembre, 2026</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ── AGENDA / PROGRAMA ──────────────────────────────────────── -->
  <section class="schedule-section">
      <!-- Tabs de Días -->
      <div class="schedule-tabs">
        <button class="schedule-tab active" id="tab-day1" type="button">
          <span class="tab-day" data-i18n="prog_tab1_day">Día 1</span>
          <span class="tab-date" data-i18n="prog_tab1_date">Miércoles 4 de noviembre</span>
        </button>
        <button class="schedule-tab" id="tab-day2" type="button">
          <span class="tab-day" data-i18n="prog_tab2_day">Día 2</span>
          <span class="tab-date" data-i18n="prog_tab2_date">Jueves 5 de noviembre</span>
        </button>
      </div>

      <!-- Contenedor Timeline Días -->
      <div class="schedule-timeline-wrapper">

    <!-- ══ DÍA 1 ════════════════════════════════════════════════════ -->
    <div id="day1" class="schedule-day active-day">
      <div class="timeline">

        <!-- BLOQUE 1: INICIO -->
        <div class="timeline-item block-header" style="margin: 2rem 0; width: 100%; display: flex; justify-content: center; z-index: 2; position: relative;">
          <div style="background: rgba(33, 208, 255, 0.1); padding: 1rem 2rem; border-radius: 12px; border: 1px solid rgba(33, 208, 255, 0.3); text-align: center; backdrop-filter: blur(10px); box-shadow: 0 0 20px rgba(33, 208, 255, 0.15);">
            <h2 style="color: var(--color-cyan); font-size: 1.5rem; margin: 0;" data-i18n="prog_d1_block1_title">BLOQUE &mdash; INICIO</h2>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">09:15 AM &mdash; 09:30 AM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t1_title">Inauguración</h3>
            <p class="talk-desc" data-i18n="prog_d1_t1_desc">Palabras de bienvenida para dar apertura oficial a TOB-ATI 2026, marcando el inicio de dos días dedicados a la innovación, el crecimiento profesional y la conexión con la industria tecnológica.</p>
            <span class="talk-tag" data-i18n="prog_d1_t1_tag">Introducción</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4 data-i18n="prog_d1_t1_who">Abril Masis &middot; Directora María José Artavia</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">09:35 AM &mdash; 09:45 AM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t2_title">Acto Cultural: Bandati</h3>
            <p class="talk-desc" data-i18n="prog_d1_t2_desc">Presentación cultural para dar un respiro musical/artístico antes de arrancar con el contenido del día.</p>
            <span class="talk-tag" data-i18n="prog_d1_t2_tag">Acto Cultural</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4>Nestor y Pedro</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">09:50 AM &mdash; 10:10 AM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t3_title">Introducción al evento</h3>
            <p class="talk-desc" data-i18n="prog_d1_t3_desc">Dinámica de bienvenida para romper el hielo entre los asistentes y presentar la mecánica, tracks y objetivos de TOB-ATI 2026.</p>
            <span class="talk-tag" data-i18n="prog_d1_t3_tag">Dinámica</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4>Julia Vargas Thompson</h4>
              </div>
            </div>
          </div>
        </div>

        <!-- BLOQUE 2: EQUILIBRIO PROPIO -->
        <div class="timeline-item block-header" style="margin: 2rem 0; width: 100%; display: flex; justify-content: center; z-index: 2; position: relative;">
          <div style="background: rgba(33, 208, 255, 0.1); padding: 1rem 2rem; border-radius: 12px; border: 1px solid rgba(33, 208, 255, 0.3); text-align: center; backdrop-filter: blur(10px); box-shadow: 0 0 20px rgba(33, 208, 255, 0.15);">
            <h2 style="color: var(--color-cyan); font-size: 1.5rem; margin-bottom: 0.5rem;" data-i18n="prog_d1_block2_title">BLOQUE &mdash; EQUILIBRIO PROPIO</h2>
            <p style="color: rgba(255,255,255,0.7); font-style: italic; margin: 0;" data-i18n="prog_d1_block2_quote">&ldquo;You can't make it change if you can't master yourself&rdquo;</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">10:15 AM &mdash; 11:00 AM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t4_title">Extraordinary Fears: a quick guide on how to transform fear</h3>
            <p class="talk-desc" data-i18n="prog_d1_t4_desc">Una guía práctica para identificar el miedo como motor de cambio en lugar de obstáculo, y cómo transformarlo en una herramienta de crecimiento personal y profesional.</p>
            <span class="talk-tag talk-tag-cyan" data-i18n="prog_d1_t4_tag">Charla</span>
            <div class="talk-speaker">
              <img src="/imagenes/speakers/speaker02.webp" alt="Tamara Sancho" loading="lazy" />
              <div class="speaker-details">
                <h4>Tamara Sancho</h4>
                <p>P&amp;G</p>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content" style="position: relative;">
            <div style="position: absolute; top:0; left:0; width:100%; height:100%; backdrop-filter: blur(8px); background: rgba(0,0,0,0.3); z-index: 10; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
              <h3 style="color: var(--color-cyan); font-size: 1.5rem; margin: 0; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 0 10px rgba(33, 208, 255, 0.5);" data-i18n="prog_soon">Pronto...</h3>
            </div>
            <div style="opacity: 0.15; pointer-events: none;">
              <div class="time-badge">11:05 AM &mdash; 11:45 AM</div>
              <h3 class="talk-title" style="background: rgba(255,255,255,0.2); width: 60%; height: 24px; border-radius: 4px; color: transparent;">-</h3>
              <p class="talk-desc" style="background: rgba(255,255,255,0.2); width: 100%; height: 48px; border-radius: 4px; color: transparent;">-</p>
              <span class="talk-tag" style="background: rgba(255,255,255,0.2); width: 80px; height: 24px; color: transparent; border: none;">-</span>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">11:45 AM &mdash; 11:50 AM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t6_title">Retroalimentación y Rifa</h3>
            <p class="talk-desc" data-i18n="prog_d1_t6_desc">Espacio para que los asistentes compartan su experiencia del bloque mediante un código QR, con una rifa como incentivo.</p>
            <span class="talk-tag" data-i18n="prog_d1_t6_tag">Rifa</span>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">12:00 PM &mdash; 12:45 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t7_title">Almuerzo</h3>
            <p class="talk-desc" data-i18n="prog_d1_t7_desc">Espacio de receso para almorzar y hacer networking informal entre asistentes, speakers y sponsors.</p>
            <span class="talk-tag" data-i18n="prog_d1_t7_tag">Receso</span>
          </div>
        </div>

        <!-- BLOQUE 3: CRECIMIENTO CONTINUO -->
        <div class="timeline-item block-header" style="margin: 2rem 0; width: 100%; display: flex; justify-content: center; z-index: 2; position: relative;">
          <div style="background: rgba(33, 208, 255, 0.1); padding: 1rem 2rem; border-radius: 12px; border: 1px solid rgba(33, 208, 255, 0.3); text-align: center; backdrop-filter: blur(10px); box-shadow: 0 0 20px rgba(33, 208, 255, 0.15);">
            <h2 style="color: var(--color-cyan); font-size: 1.5rem; margin-bottom: 0.5rem;" data-i18n="prog_d1_block3_title">BLOQUE &mdash; CRECIMIENTO CONTINUO</h2>
            <p style="color: rgba(255,255,255,0.7); font-style: italic; margin: 0;" data-i18n="prog_d1_block3_quote">&ldquo;Technology never stops evolving, so why should me?&rdquo;</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">01:00 PM &mdash; 01:45 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t8_title">Empresa de 0 a 1M</h3>
            <p class="talk-desc" data-i18n="prog_d1_t8_desc">El camino real de construir una startup desde cero hasta el primer millón: los retos, decisiones clave y aprendizajes de escalar un negocio tecnológico en Latinoamérica.</p>
            <span class="talk-tag talk-tag-cyan" data-i18n="prog_d1_t8_tag">Charla</span>
            <div class="talk-speaker">
              <img src="/imagenes/speakers/speaker01.webp" alt="Pedro Gutiérrez" loading="lazy" />
              <div class="speaker-details">
                <h4>Pedro Gutiérrez</h4>
                <p>CEO &middot; Avify</p>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content" style="position: relative;">
            <div style="position: absolute; top:0; left:0; width:100%; height:100%; backdrop-filter: blur(8px); background: rgba(0,0,0,0.3); z-index: 10; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
              <h3 style="color: var(--color-cyan); font-size: 1.5rem; margin: 0; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 0 10px rgba(33, 208, 255, 0.5);" data-i18n="prog_soon">Pronto...</h3>
            </div>
            <div style="opacity: 0.15; pointer-events: none;">
              <div class="time-badge">01:50 PM &mdash; 02:30 PM</div>
              <h3 class="talk-title" style="background: rgba(255,255,255,0.2); width: 60%; height: 24px; border-radius: 4px; color: transparent;">-</h3>
              <p class="talk-desc" style="background: rgba(255,255,255,0.2); width: 100%; height: 48px; border-radius: 4px; color: transparent;">-</p>
              <span class="talk-tag" style="background: rgba(255,255,255,0.2); width: 80px; height: 24px; color: transparent; border: none;">-</span>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">02:35 PM &mdash; 02:45 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t10_title">Acto Cultural</h3>
            <p class="talk-desc" data-i18n="prog_d1_t10_desc">Presentación cultural para dar dinamismo entre bloques de contenido.</p>
            <span class="talk-tag" data-i18n="prog_d1_t10_tag">Acto Cultural</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4>Melody Coto</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">02:50 PM &mdash; 03:50 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t11_title">Panel Híbrido: Mujeres en Tech &mdash; Liderando con resiliencia en la industria tech</h3>
            <p class="talk-desc" data-i18n="prog_d1_t11_desc">Un panel de conversación con líderes mujeres de la industria tecnológica, explorando los retos, estrategias y resiliencia necesarias para liderar en el sector.</p>
            <span class="talk-tag talk-tag-cyan" data-i18n="prog_d1_t11_tag">Panel Híbrido</span>
            <div class="talk-speaker">
              <img src="/imagenes/speakers/speaker03.webp" alt="Pilar Sánchez" loading="lazy" />
              <div class="speaker-details">
                <h4 data-i18n="prog_d1_t11_who">Pilar Sánchez (Avify) &amp; Wendy Badilla (Microsoft)</h4>
                <p data-i18n="prog_d1_t11_note">Participación: Equifax, WWT</p>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">03:50 PM &mdash; 03:55 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t12_title">Retroalimentación y Rifa</h3>
            <p class="talk-desc" data-i18n="prog_d1_t12_desc">Espacio para retroalimentación vía QR con rifa incluida.</p>
            <span class="talk-tag" data-i18n="prog_d1_t12_tag">Rifa</span>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">03:55 PM &mdash; 04:05 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t13_title">Receso</h3>
            <p class="talk-desc" data-i18n="prog_d1_t13_desc">Pausa corta antes de continuar con el siguiente bloque.</p>
            <span class="talk-tag" data-i18n="prog_d1_t13_tag">Receso</span>
          </div>
        </div>

        <!-- BLOQUE 4: PRODUCTIVIDAD PERSONAL -->
        <div class="timeline-item block-header" style="margin: 2rem 0; width: 100%; display: flex; justify-content: center; z-index: 2; position: relative;">
          <div style="background: rgba(33, 208, 255, 0.1); padding: 1rem 2rem; border-radius: 12px; border: 1px solid rgba(33, 208, 255, 0.3); text-align: center; backdrop-filter: blur(10px); box-shadow: 0 0 20px rgba(33, 208, 255, 0.15);">
            <h2 style="color: var(--color-cyan); font-size: 1.5rem; margin-bottom: 0.5rem;" data-i18n="prog_d1_block4_title">BLOQUE &mdash; PRODUCTIVIDAD PERSONAL</h2>
            <p style="color: rgba(255,255,255,0.7); font-style: italic; margin: 0;" data-i18n="prog_d1_block4_quote">&ldquo;We don't count the hours, we make the hours count&rdquo;</p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">04:05 PM &mdash; 04:50 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t14_title">Finanzas personales en inversiones</h3>
            <p class="talk-desc" data-i18n="prog_d1_t14_desc">Fundamentos prácticos para empezar a invertir con criterio: cómo construir una base financiera sólida y tomar decisiones informadas.</p>
            <span class="talk-tag talk-tag-cyan" data-i18n="prog_d1_t14_tag">Charla</span>
            <div class="talk-speaker">
              <img src="/imagenes/speakers/speaker05.webp" alt="Aaron Omodeo" loading="lazy" />
              <div class="speaker-details">
                <h4>Aaron Omodeo</h4>
                <p>Doji Club</p>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">04:55 PM &mdash; 05:40 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t15_title">Tips and tricks para una entrevista y crear el CV</h3>
            <p class="talk-desc" data-i18n="prog_d1_t15_desc">Consejos prácticos y directos para destacar en procesos de selección: desde cómo estructurar un CV efectivo hasta cómo prepararse para una entrevista.</p>
            <span class="talk-tag talk-tag-cyan" data-i18n="prog_d1_t15_tag">Charla</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4>Equifax</h4>
                <p data-i18n="prog_d1_t15_note">Speaker por confirmar</p>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">05:45 PM &mdash; 05:55 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t16_title">Acto Cultural: Cortometraje</h3>
            <p class="talk-desc" data-i18n="prog_d1_t16_desc">Proyección de un cortometraje como cierre artístico del bloque.</p>
            <span class="talk-tag" data-i18n="prog_d1_t16_tag">Acto Cultural</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4>Randy Masis</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">06:35 PM &mdash; 06:45 PM</div>
            <h3 class="talk-title" data-i18n="prog_d1_t18_title">Cierre y Rifa</h3>
            <p class="talk-desc" data-i18n="prog_d1_t18_desc">Retroalimentación final del día, cierre oficial y última rifa de la jornada.</p>
            <span class="talk-tag" data-i18n="prog_d1_t18_tag">Cierre</span>
          </div>
        </div>

      </div>
    </div>

    <!-- ══ DÍA 2 ════════════════════════════════════════════════════ -->
    <div id="day2" class="schedule-day">
      <div class="timeline">

        <!-- BLOQUE 1: INICIO -->
        <div class="timeline-item block-header" style="margin: 2rem 0; width: 100%; display: flex; justify-content: center; z-index: 2; position: relative;">
          <div style="background: rgba(33, 208, 255, 0.1); padding: 1rem 2rem; border-radius: 12px; border: 1px solid rgba(33, 208, 255, 0.3); text-align: center; backdrop-filter: blur(10px); box-shadow: 0 0 20px rgba(33, 208, 255, 0.15);">
            <h2 style="color: var(--color-cyan); font-size: 1.5rem; margin: 0;" data-i18n="prog_d2_block1_title">BLOQUE &mdash; INICIO</h2>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">09:15 AM &mdash; 09:25 AM</div>
            <h3 class="talk-title" data-i18n="prog_d2_t1_title">Inicio del último día</h3>
            <p class="talk-desc" data-i18n="prog_d2_t1_desc">Apertura de la segunda y última jornada de TOB-ATI 2026, enfocada en optimización, datos y tecnologías disruptivas.</p>
            <span class="talk-tag" data-i18n="prog_d2_t1_tag">Introducción</span>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">09:30 AM &mdash; 09:40 AM</div>
            <h3 class="talk-title" data-i18n="prog_d2_t2_title">Acto Cultural</h3>
            <p class="talk-desc" data-i18n="prog_d2_t2_desc">Presentación cultural para dar inicio al día con energía.</p>
            <span class="talk-tag" data-i18n="prog_d2_t2_tag">Acto Cultural</span>
            <div class="talk-speaker">
              <div class="speaker-details">
                <h4>Rubén Monarca</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <div class="time-badge">09:45 AM &mdash; 10:00 AM</div>
            <h3 class="talk-title" data-i18n="prog_d2_t3_title">Introducción al día</h3>
            <p class="talk-desc" data-i18n="prog_d2_t3_desc">Formato podcast para presentar de forma dinámica los temas y objetivos del día.</p>
            <span class="talk-tag" data-i18n="prog_d2_t3_tag">Podcast</span>
            <div class="talk-speaker">
              <img src="/imagenes/host/presentador01.webp" alt="Anthony Fuentes" loading="lazy" />
              <div class="speaker-details">
                <h4>Anthony Fuentes</h4>
              </div>
            </div>
          </div>
        </div>

