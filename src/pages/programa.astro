---
import Layout from '../layouts/Layout.astro';
import { programa, personaPorId, tipoLabel, TIPOS_CON_LUMA } from '../data/tob2026';
---

<Layout>
  <!-- ── FONDO ESPECÍFICO DEL PROGRAMA ────────────────────────── -->
  <div class="programa-page-bg" aria-hidden="true"></div>

  <!-- ── HERO DEL PROGRAMA ──────────────────────────────────────── -->
  <header class="programa-hero">
    <div class="programa-hero-overlay"></div>
    <div class="programa-hero-content">
      <div class="programa-hero-text">
        <h1 class="programa-title" data-i18n="prog_hero_title">Programa del <span class="text-cyan">Evento</span></h1>
        <p class="programa-slogan" data-i18n="prog_hero_slogan">
          Dos días de conferencias, talleres y networking con los líderes de la industria tecnológica.
        </p>
        <div class="programa-dates">
          <div class="date-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span data-i18n="prog_date1">Miércoles 4 de noviembre, 2026</span>
          </div>
          <span class="date-separator">&mdash;</span>
          <div class="date-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span data-i18n="prog_date2">Jueves 5 de noviembre, 2026</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ── AGENDA / PROGRAMA ──────────────────────────────────────── -->
  <section class="schedule-section">
      <!-- Tabs de Días -->
      <div class="schedule-tabs">
        <button class="schedule-tab active" id="tab-day1" type="button">
          <span class="tab-day" data-i18n="prog_tab1_day">Día 1</span>
          <span class="tab-date" data-i18n="prog_tab1_date">Miércoles 4 de noviembre</span>
        </button>
        <button class="schedule-tab" id="tab-day2" type="button">
          <span class="tab-day" data-i18n="prog_tab2_day">Día 2</span>
          <span class="tab-date" data-i18n="prog_tab2_date">Jueves 5 de noviembre</span>
        </button>
      </div>

      <!-- Contenedor Timeline Días (generado desde src/data/tob2026.ts) -->
      <div class="schedule-timeline-wrapper">
        {programa.map((dia, i) => (
          <div id={dia.id} class:list={["schedule-day", { "active-day": i === 0 }]}>
            <div class="timeline">
              {dia.bloques.map((bloque) => (
                <Fragment>
                  <div class="timeline-item block-header">
                    <div class="block-header-box">
                      <h2 data-i18n={bloque.tituloKey}>{bloque.titulo}</h2>
                      {bloque.frase && <p data-i18n={bloque.fraseKey}>{bloque.frase}</p>}
                    </div>
                  </div>

                  {bloque.sesiones.map((s) => {
                    const gente = s.personas.map((id) => personaPorId.get(id)!);
                    const conLuma = TIPOS_CON_LUMA.includes(s.tipo);
                    const luma = bloque.luma ?? dia.luma;
                    return (
                      <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <article class={`timeline-content session-card is-${s.tipo}`}>
                          <div class="card-top">
                            <div class="time-badge">{s.hora}</div>
                            <span class:list={["talk-tag", { "talk-tag-cyan": conLuma }]} data-i18n={`prg_tag_${s.tipo}`}>{tipoLabel[s.tipo]}</span>
                          </div>
                          <h3 class="talk-title" data-i18n={`prg_${s.key}_title`}>{s.titulo}</h3>
                          <p class="talk-desc" data-i18n={`prg_${s.key}_desc`}>{s.desc}</p>

                          <ul class="talk-people">
                            {gente.map((p) => (
                              <li class="talk-speaker">
                                <img src={p.foto} alt={p.nombre} width="48" height="48" loading="lazy" decoding="async" />
                                <div class="speaker-details">
                                  <h4>{p.nombre}</h4>
                                  <p data-i18n={`ppl_${p.id}_role`}>{p.rol}</p>
                                </div>
                              </li>
                            ))}
                          </ul>

                          {conLuma && (luma ? (
                            <a class="luma-btn" href={luma} target="_blank" rel="noopener noreferrer">
                              <span class="luma-btn-label" data-i18n="prg_luma_cta">Inscribirme en Luma</span>
                              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                            </a>
                          ) : (
                            <span class="luma-btn is-soon" aria-disabled="true">
                              <span class="luma-btn-label" data-i18n="prg_luma_soon">Inscripción muy pronto</span>
                            </span>
                          ))}
                        </article>
                      </div>
                    );
                  })}
                </Fragment>
              ))}
            </div>
          </div>
        ))}
  </div> <!-- /schedule-timeline-wrapper -->
</section>

  <!-- ── INTERACTIVE TAB SWITCHING SCRIPT ───────────────────────── -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tab1 = document.getElementById('tab-day1');
      const tab2 = document.getElementById('tab-day2');
      const day1 = document.getElementById('day1');
      const day2 = document.getElementById('day2');

      function switchTab(targetDay) {
        if (targetDay === 'day1') {
          tab1?.classList.add('active');
          tab2?.classList.remove('active');
          day1?.classList.add('active-day');
          day2?.classList.remove('active-day');
        } else {
          tab2?.classList.add('active');
          tab1?.classList.remove('active');
          day2?.classList.add('active-day');
          day1?.classList.remove('active-day');
        }
      }

      tab1?.addEventListener('click', () => switchTab('day1'));
      tab2?.addEventListener('click', () => switchTab('day2'));
    });
  </script>
</Layout>

<style>
  /* El planeta vive en el fondo fijo del body. En esta página se apaga. */
  :global(body) {
    background: #0d0406;
  }

  /* ── Fondo único de la página Programa ── */
  .programa-page-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #0d0406;
    background-image:
      linear-gradient(rgba(10, 15, 25, 0.62), rgba(10, 15, 25, 0.86)),
      url('/imagenes/programa/FondoPrograma.webp');
    background-size: cover, 80% auto;
    background-position: center, center 8%;
    background-repeat: no-repeat;
    z-index: 0;
    pointer-events: none;
  }

  .programa-hero,
  .schedule-section {
    position: relative;
    z-index: 1;
  }

  :global(.site-footer) {
    position: relative;
    z-index: 10;
    background: #010204;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* ── Encabezado de bloque ── */
  .block-header {
    margin: 2rem 0;
    display: flex;
    justify-content: center;
    padding-left: 0;
    z-index: 2;
  }

  .block-header-box {
    background: rgba(33, 208, 255, 0.1);
    padding: 1rem 2rem;
    border-radius: 12px;
    border: 1px solid rgba(33, 208, 255, 0.3);
    text-align: center;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 20px rgba(33, 208, 255, 0.15);
  }

  .block-header-box h2 {
    color: var(--color-cyan);
    font-size: 1.5rem;
    margin: 0;
  }

  .block-header-box p {
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
    margin: 0.5rem 0 0;
  }

  /* ── Card de sesión: misma estructura para todas ── */
  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .card-top .time-badge {
    margin-bottom: 0;
  }

  .talk-people {
    list-style: none;
    margin: 20px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }

  .talk-people .talk-speaker {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .talk-people .talk-speaker img {
    flex-shrink: 0;
    background: #06263f;
  }

  .is-cultural {
    border-color: rgba(255, 196, 92, 0.22);
  }

  .is-rifa,
  .is-receso {
    background: rgba(255, 255, 255, 0.025);
  }

  /* ── Botón de inscripción en Luma ── */
  .luma-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding: 12px 22px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.3px;
    color: #03141f;
    text-decoration: none;
    background: linear-gradient(110deg, #21d0ff 0%, #7be6ff 45%, #21d0ff 55%, #1497e0 100%);
    background-size: 220% 100%;
    box-shadow: 0 0 0 1px rgba(33, 208, 255, 0.5), 0 8px 24px rgba(33, 208, 255, 0.28);
    overflow: hidden;
    isolation: isolate;
    animation: luma-shine 3.2s ease-in-out infinite;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .luma-btn::after {
    content: "";
    position: absolute;
    inset: -2px;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(circle at 50% 120%, rgba(255, 255, 255, 0.55), transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .luma-btn svg {
    transition: transform 0.25s ease;
  }

  .luma-btn:hover,
  .luma-btn:focus-visible {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 0 1px #7be6ff, 0 12px 34px rgba(33, 208, 255, 0.5), 0 0 40px rgba(33, 208, 255, 0.35);
  }

  .luma-btn:hover::after,
  .luma-btn:focus-visible::after {
    opacity: 1;
  }

  .luma-btn:hover svg,
  .luma-btn:focus-visible svg {
    transform: translateX(4px);
  }

  .luma-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .luma-btn.is-soon {
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(33, 208, 255, 0.35);
    animation: none;
    cursor: default;
  }

  .luma-btn.is-soon:hover {
    transform: none;
  }

  @keyframes luma-shine {
    0%, 100% { background-position: 100% 0; }
    50% { background-position: 0% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .luma-btn {
      animation: none;
    }
  }

  @media (max-width: 520px) {
    .luma-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
