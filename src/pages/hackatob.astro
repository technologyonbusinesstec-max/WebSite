<script>
  // ─── Phrase Rotator ───
  const phrases = [
    'Convierte ideas en soluciones',
    'Innova. Conecta. Transforma.',
    'Construye el futuro.',
    'Hack. Build. Launch.',
    '4 días de aprendizaje',
    'Instituto Tecnológico de Costa Rica'
  ];
  let pIdx = 0;
  const phraseEl = document.getElementById('hackRotatorPhrase');
  if (phraseEl) {
    function showPhrase(idx: number) {
      if (!phraseEl) return;
      phraseEl.textContent = phrases[idx % phrases.length];
      phraseEl.classList.remove('leaving');
      void phraseEl.offsetWidth;
      phraseEl.classList.add('entering');
    }

    function nextPhrase() {
      if (!phraseEl) return;
      phraseEl.classList.remove('entering');
      phraseEl.classList.add('leaving');
      setTimeout(() => {
        pIdx = (pIdx + 1) % phrases.length;
        showPhrase(pIdx);
      }, 400);
    }

    showPhrase(0);
    setInterval(nextPhrase, 3000);
  }

  // ─── Counter Animation ───
  function animateCounters() {
    document.querySelectorAll('.metric-number').forEach(el => {
      const target = parseInt(el.dataset.target || '0', 10);
      const prefix = el.dataset.prefix || '';
      let current = 0;
      const step = Math.ceil(target / 40);
      const timer = setInterval(() => {
        current = Math.min(current + step, target);
        el.textContent = prefix + current;
        if (current >= target) clearInterval(timer);
      }, 40);
    });
  }
  const metricsSection = document.querySelector('.hackatob-metrics-section');
  if (metricsSection) {
    const obs = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { animateCounters(); obs.disconnect(); }
    }, { threshold: 0.3 });
    obs.observe(metricsSection);
  }

  // ─── Prize Card Flip ───
  document.querySelectorAll('.prize-card-container').forEach(container => {
    container.addEventListener('click', () => {
      container.querySelector('.prize-card-inner')?.classList.toggle('flipped');
    });
  });

  // ─── FAQ Stack ───
  const cards = Array.from(document.querySelectorAll('.faq-stack-card'));
  const dotsWrapper = document.getElementById('faqDotsWrapper');
  const prevBtn = document.getElementById('faqPrevBtn');
  const nextBtn = document.getElementById('faqNextBtn');
  let currentFaq = 0;

  function buildDots() {
    if (!dotsWrapper) return;
    dotsWrapper.innerHTML = '';
    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'faq-dot' + (i === currentFaq ? ' active' : '');
      dot.setAttribute('aria-label', `Pregunta ${i + 1}`);
      dot.addEventListener('click', () => goToFaq(i));
      dotsWrapper.appendChild(dot);
    });
  }

  function goToFaq(idx: number) {
    currentFaq = (idx + cards.length) % cards.length;
    cards.forEach((card, i) => {
      card.classList.remove('faq-active', 'faq-prev', 'faq-next');
      const diff = i - currentFaq;
      if (diff === 0) card.classList.add('faq-active');
      else if (diff > 0 && diff <= 2) card.classList.add('faq-next');
      else card.classList.add('faq-prev');
      (card as HTMLElement).style.zIndex = String(cards.length - Math.abs(diff));
    });
    buildDots();
  }

  if (cards.length > 0) {
    buildDots();
    goToFaq(0);
    prevBtn?.addEventListener('click', () => goToFaq(currentFaq - 1));
    nextBtn?.addEventListener('click', () => goToFaq(currentFaq + 1));
  }

  // ─── Mobile Menu Toggle ───
  const menuToggle = document.getElementById('hackMenuToggle');
  const mobileNav = document.getElementById('hackMobileNav');
  menuToggle?.addEventListener('click', () => {
    mobileNav?.classList.toggle('open');
  });

  document.querySelectorAll('.hack-mobile-link').forEach(link => {
    link.addEventListener('click', () => mobileNav?.classList.remove('open'));
  });

  // ─── Lang Selector ───
  const langToggle = document.getElementById('hackLangToggle');
  langToggle?.addEventListener('click', () => {
    const texts = langToggle.querySelectorAll('.hack-lang-text');
    texts.forEach(t => t.classList.toggle('active'));
  });

  // ─── Scroll Top ───
  const scrollBtn = document.getElementById('scrollTopBtn');
  if (scrollBtn) scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

