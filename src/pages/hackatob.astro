---
// src/pages/hackatob.astro
import HackaLayout from '../layouts/HackaLayout.astro';
import BigBangBackground from '../components/hackatob/BigBangBackground.astro';
import HackaCountdown from '../components/hackatob/HackaCountdown.astro';
import HackaQueEs from '../components/hackatob/HackaQueEs.astro';
import HackaParaQuien from '../components/hackatob/HackaParaQuien.astro';
import HackaRedes from '../components/hackatob/HackaRedes.astro';
import HackaTracks from '../components/hackatob/HackaTracks.astro';
import HackaPrograma from '../components/hackatob/HackaPrograma.astro';
import HackaPremios from '../components/hackatob/HackaPremios.astro';
import HackaMentores from '../components/hackatob/HackaMentores.astro';
import HackaSedes from '../components/hackatob/HackaSedes.astro';
import HackaSphere from '../components/hackatob/HackaSphere.astro';

// Frases que rotan bajo el título cada vez que se toca la esfera (la primera es la de inicio).
// Se muestran en el idioma activo del sitio; "Technology on Business" es el nombre del evento y no se traduce.
const heroPhrases = [
  { es: 'Technology on Business', en: 'Technology on Business' },
  { es: 'Ideas en lanzamiento', en: 'Ideas on Launch' },
  { es: 'Código en órbita', en: 'Code on Orbit' },
  { es: 'Equipos en misión', en: 'Teams on Mission' },
  { es: 'Hackers a bordo', en: 'Hackers on Board' },
  { es: 'Innovación bajo demanda', en: 'Innovation on Demand' },
  { es: 'Datos con propósito', en: 'Data on Purpose' },
  { es: 'Diseño encendido', en: 'Design on Fire' },
  { es: 'Startups en despegue', en: 'Startups on Liftoff' },
  { es: 'Talento en escena', en: 'Talent on Stage' },
  { es: 'Sueños en marcha', en: 'Dreams on Deploy' },
];
---

<!-- basePath vacío: las secciones del menú están en esta página. earthFade: el footer sube después de la Tierra. -->
<HackaLayout basePath="" earthFade>
  <BigBangBackground slot="background" />

  <!-- Cada .hk-stage es una etapa del fondo (el scroll de la página la recorre). Aquí va el contenido real. -->
  <main class="hackatob">
    <!-- ETAPA 1 – Singularidad: punto de luz que late -->
    <section class="hk-stage hk-stage-hero">
      <!-- Columna izquierda: el punto de luz late en el centro de la pantalla y debe quedar libre -->
      <div class="hk-hero">
        <h1 class="hk-hero-title">HackaToB</h1>
        <p class="hk-hero-date" data-i18n="hack_hero_date">Noviembre 2 &ndash; 6, 2026</p>
        <p class="hk-hero-org" id="hkHeroOrg" data-phrases={JSON.stringify(heroPhrases)}>{heroPhrases[0].es}</p>
      </div>
      <!-- Columna derecha: esfera de partículas interactiva -->
      <HackaSphere />
    </section>

    <!-- ETAPA 2 – Explosión: Qué es HackaToB -->
    <section class="hk-stage hk-stage-que-es" id="que-es">
      <HackaQueEs />
    </section>

    <!-- ETAPA 3 – Plasma caliente: aquí el fondo se cierra con una cortina (difuminado → sólido → difuminado),
         igual que la del footer, y vuelve a abrirse al Big Bang. Dentro va el frame "¿Para quién es?". -->
    <section class="hk-stage hk-stage-frame" id="participantes">
      <div class="hk-frame fade-curtain fade-curtain--bottom">
        <HackaParaQuien />
      </div>
      <!-- Redes del ToB: la cinta va montada sobre el difuminado de salida, donde reaparece el Big Bang -->
      <div class="hk-frame-redes">
        <HackaRedes />
      </div>
    </section>
    <!-- ETAPA 4 – Enfriamiento: los cuatro tracks -->
    <section class="hk-stage hk-stage-tracks" id="tracks">
      <HackaTracks />
    </section>
    <!-- ETAPA 5 – Primeras estrellas: el programa de la semana -->
    <section class="hk-stage hk-stage-programa" id="programa">
      <HackaPrograma />
    </section>
    <!-- ETAPA 6 – Galaxia: los premios del Top 3 -->
    <section class="hk-stage hk-stage-premios" id="premios">
      <HackaPremios />
    </section>
    <!-- Mentores, todavía en la galaxia. data-hk-hold="full": mientras se recorre, el fondo no avanza
         (así la galaxia sigue igual y las etapas que vienen no se desfasan) -->
    <section class="hk-stage hk-stage-mentores" id="mentores" data-hk-hold="full">
      <HackaMentores />
    </section>
    <!-- ETAPA 7 – Tierra: acercamiento a Costa Rica, pin y las dos sedes presenciales -->
    <section class="hk-stage hk-stage-tierra" id="sedes">
      <HackaSedes />
    </section>

    <!-- Cuenta regresiva fija: el scroll la acelera hasta el despegue en la Tierra -->
    <HackaCountdown />
  </main>
</HackaLayout>

<script>
  // Cada toque a la esfera del hero pasa a la siguiente frase (se desvanece, cambia y vuelve).
  // El idioma sigue al del sitio: 'tob_lang' al cargar y el evento languageChanged de public/lang.js.
  const org = document.getElementById('hkHeroOrg');
  if (org) {
    type Lang = 'es' | 'en';
    const phrases: Record<Lang, string>[] = JSON.parse(org.dataset.phrases || '[]');
    const toLang = (value: unknown): Lang => (String(value).toLowerCase() === 'en' ? 'en' : 'es');
    let lang = toLang(localStorage.getItem('tob_lang'));
    let index = 0;
    let swapId: ReturnType<typeof setTimeout> | undefined;
    const render = () => {
      if (phrases[index]) org.textContent = phrases[index][lang];
    };
    render();

    window.addEventListener('languageChanged', (e) => {
      lang = toLang((e as CustomEvent).detail?.lang);
      render();
    });

    window.addEventListener('hackaSphereTap', () => {
      if (phrases.length < 2) return;
      index = (index + 1) % phrases.length;
      clearTimeout(swapId);
      org.classList.add('is-leaving');
      swapId = setTimeout(() => {
        render();
        org.classList.remove('is-leaving');
      }, 180);
    });
  }
</script>

<style>
  .hackatob {
    position: relative;
    z-index: 1;
  }

  .hk-stage {
    min-height: calc(100vh / var(--hk-z, 1));
    padding: 80px 16px;
    display: flex;
    align-items: center;
  }

  .hk-stage-que-es {
    padding: 100px 24px;
    justify-content: center;
  }

  /* etapas con un frame centrado */
  .hk-stage-tracks,
  .hk-stage-programa {
    padding: 100px 24px;
    justify-content: center;
  }

  /* Premios maneja su propio largo y relleno: es un recorrido por scroll con el frame fijo (HackaPremios.astro) */
  .hk-stage-premios {
    display: block;
    padding: 0; /* la galaxia de Premios va a lo ancho de la pantalla */
  }

  /* Mentores: la sección (estilos de expositores del ToB) trae su propio relleno.
     Se monta sobre el final de Premios: con el logo de HackaToB formado (paso 5), sube desde abajo
     justo donde quedaba el cierre. -0.9 pantallas = 0.2 de pantalla + 0.7 del tramo del paso 5 (100vh). */
  .hk-stage-mentores {
    position: relative;
    z-index: 2;
    display: block;
    padding: 0;
  }

  /* solo con Premios fijado (.is-pinned lo pone su script); sin animación, cada sección va en su lugar */
  .hk-stage-premios:has(.is-pinned) + .hk-stage-mentores {
    margin-top: calc(-90vh / var(--hk-z, 1));
  }

  /* Etapa de la Tierra: las tarjetas de sedes (HackaSedes) ocupan todo el alto para fijarse al final */
  .hk-stage-tierra {
    align-items: stretch;
    padding: 0;
  }

  /* El fondo avanza según la fracción del scroll total: lo que Mentores se monta sobre Premios
     se le devuelve a la etapa de la Tierra, para que el largo total (y la sincronía del fondo) no cambie. */
  .hk-stage-premios:has(.is-pinned) ~ .hk-stage-tierra {
    min-height: calc(190vh / var(--hk-z, 1));
  }

  /* en móvil los tramos de Premios miden 80svh: 0.2 de pantalla + 0.7 × 80 */
  @media (max-width: 767px) {
    .hk-stage-premios:has(.is-pinned) + .hk-stage-mentores {
      margin-top: calc(-76svh / var(--hk-z, 1));
    }

    .hk-stage-premios:has(.is-pinned) ~ .hk-stage-tierra {
      min-height: calc(176svh / var(--hk-z, 1));
    }
  }

  /* ---------- Etapa 3: frame de fondo sólido entre dos cortinas (src/styles/fade-curtain.css) ---------- */
  .hk-stage-frame {
    --hk-frame-fade: min(560px, calc(75vh / var(--hk-z, 1))); /* largo de cada difuminado de la cortina */
    display: flow-root; /* contiene los márgenes de .hk-frame dentro de la etapa */
    padding: 0;
  }

  /* sube hasta meterse en el difuminado de salida de .hk-frame (que ocupa su margen inferior) */
  .hk-frame-redes {
    position: relative;
    z-index: 2; /* por encima de la cortina */
    margin-top: calc(var(--hk-frame-fade) * -0.66);
    padding-bottom: calc(var(--hk-frame-fade) * 0.12);
  }

  .hk-frame {
    /* cortina más larga y más desenfocada que la del footer (320px / 12px) */
    --fc-size: var(--hk-frame-fade);
    --fc-blur: 24px;
    /* los dos difuminados caben en el margen: no tapan el contenido de las etapas vecinas */
    margin-block: var(--fc-size);
    min-height: calc(70vh / var(--hk-z, 1));
    display: flex;
    align-items: center;
  }

  /* ---------- Etapa 1: título ---------- */
  .hk-stage-hero {
    position: relative; /* referencia de la esfera de la columna derecha */
    --hk-hero-gap: clamp(16px, calc(6vw / var(--hk-z, 1)), 96px); /* separación con los bordes laterales */
    /* ancho de cada columna: media pantalla menos el radio del punto de luz (~140px al latir) */
    --hk-hero-col: calc(calc(50vw / var(--hk-z, 1)) - 150px - var(--hk-hero-gap) - 16px);
  }

  .hk-hero {
    width: var(--hk-hero-col);
    margin-left: var(--hk-hero-gap);
    container-type: inline-size;
  }

  .hk-hero-title {
    margin: 0;
    font-size: min(18cqi, 128px); /* ocupa el ancho de la columna sin desbordarla */
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 0 40px rgba(255, 170, 100, 0.35);
  }

  .hk-hero-date,
  .hk-hero-org {
    margin: 0;
    font-size: clamp(12px, 4.2cqi, 16px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hk-hero-date {
    margin-top: 18px;
    color: #ecebf7;
  }

  /* la frase que cambia al tocar la esfera: más grande que la fecha */
  .hk-hero-org {
    margin-top: 10px;
    font-size: clamp(16px, 5.2cqi, 32px); /* la frase más larga cabe en una línea */
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #7c7b94; /* gris más oscuro que la fecha; sobre el fondo negro sigue pasando AA (~5:1) */
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .hk-hero-org.is-leaving {
    opacity: 0;
    transform: translateY(-6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-hero-org,
    .hk-hero-org.is-leaving {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 700px) {
    /* (la etapa de la Tierra no: sus tarjetas de sedes necesitan todo el alto) */
    .hk-stage:last-of-type:not(.hk-stage-tierra),
    .hk-stage-hero {
      align-items: flex-start;
    }

    /* Sin columna libre a la izquierda: el título sube por encima del punto de luz */
    .hk-stage-hero {
      --hk-hero-gap: 8px;
    }

    .hk-hero {
      width: calc(100% - 16px);
    }
  }
</style>
