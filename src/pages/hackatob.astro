---
// src/pages/hackatob.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="HackaToB 2026 – Technology on Business" description="El Hackathon oficial del congreso Technology on Business." hideNavbar={true} hideFooter={true}>

  <!-- ───── NAVBAR HACKATOB ───── -->
  <nav class="hack-navbar" id="hackNavbar">
    <div class="hack-navbar-left">
      <a href="/" class="hack-back-btn">&larr; Volver al ToB</a>
    </div>
    <div class="hack-navbar-center">
      <a href="#premios" class="hack-nav-link">Premios</a>
      <a href="#tracks" class="hack-nav-link">Tracks</a>
      <a href="#sedes" class="hack-nav-link">Sedes</a>
      <a href="#agenda-preview" class="hack-nav-link hack-nav-link-gold">Agenda</a>
      <a href="#mentores" class="hack-nav-link">Mentores</a>
      <a href="#sponsors" class="hack-nav-link">Sponsors</a>
      <a href="#faq" class="hack-nav-link">FAQ</a>
    </div>
    <div class="hack-navbar-right">
      <div class="hack-lang-selector" id="hackLangToggle">
        <span class="hack-lang-text active">ES</span>
        <span class="hack-lang-text">EN</span>
      </div>
      <a href="https://techrebel.io/" target="_blank" rel="noopener noreferrer" class="hack-participate-btn">Participar</a>
      <button class="hack-menu-toggle" id="hackMenuToggle" aria-label="Menú">
        <span class="hack-hamburger"></span>
      </button>
    </div>
  </nav>

  <!-- Menú Móvil HackaToB -->
  <div class="hack-mobile-nav" id="hackMobileNav">
    <a href="/" class="hack-mobile-link" style="color: #21d0ff; font-weight: bold;">&larr; Volver al ToB</a>
    <a href="#premios" class="hack-mobile-link">Premios</a>
    <a href="#tracks" class="hack-mobile-link">Tracks</a>
    <a href="#sedes" class="hack-mobile-link">Sedes</a>
    <a href="#agenda-preview" class="hack-mobile-link" style="color: #ffd700;">Agenda</a>
    <a href="#mentores" class="hack-mobile-link">Mentores</a>
    <a href="#sponsors" class="hack-mobile-link">Sponsors</a>
    <a href="#faq" class="hack-mobile-link">FAQ</a>
    <div class="hack-mobile-actions" style="margin-top: 10px;">
      <a href="https://techrebel.io/" target="_blank" rel="noopener noreferrer" class="hack-participate-btn" style="display: block; text-align: center; width: 100%;">Participar</a>
    </div>
  </div>

  <!-- ───── HERO ───── -->
  <section class="hackathon-hero">
    <div class="hackathon-hero-container">
      <div class="hackathon-hero-content-left">
        <p class="hero-eyebrow">TECHNOLOGY ON BUSINESS</p>
        <h1 class="hero-title hackatob-hero-title">
          <span class="htitle-white">Hacka</span><br>
          <span class="htitle-cyan">ToB</span><br>
          <span class="htitle-cyan">2026</span>
        </h1>
        <div class="hero-rotator" aria-live="polite">
          <span class="rotator-phrase entering" id="hackRotatorPhrase">Convierte ideas en soluciones</span>
        </div>
        <a href="https://techrebel.io/" target="_blank" rel="noopener noreferrer" class="hack-hero-cta">Quiero participar</a>
      </div>
      <div class="hackathon-hero-content-right">
        <img src="/imagenes/hackatob/spark.webp" alt="Mascota Spark" class="hackatob-mascot" id="mascotSpark">
      </div>
    </div>
  </section>

  <!-- ───── MÉTRICAS ───── -->
  <section class="hackatob-metrics-section">
    <div class="metrics-container">
      <h2 class="metrics-title">La escala de la primera<br>edición.</h2>
      <div class="metrics-grid">
        <div class="metric-card" style="--card-bg: url('/imagenes/hackatob/indicador01.webp');">
          <span class="metric-number" data-target="80" data-prefix="">0</span>
          <span class="metric-label">Estudiantes esperados</span>
        </div>
        <div class="metric-card" style="--card-bg: url('/imagenes/hackatob/indicador02webp.jpeg');">
          <span class="metric-number" data-target="15" data-prefix="+">0</span>
          <span class="metric-label">Proyectos</span>
        </div>
        <div class="metric-card" style="--card-bg: url('/imagenes/hackatob/indicador03.webp');">
          <span class="metric-number" data-target="3" data-prefix="">0</span>
          <span class="metric-label">Tracks</span>
        </div>
        <div class="metric-card" style="--card-bg: url('/imagenes/hackatob/indicador04.webp');">
          <span class="metric-number" data-target="15" data-prefix="">0</span>
          <span class="metric-label">Mentores</span>
        </div>
        <div class="metric-card" style="--card-bg: url('/imagenes/hackatob/indicadores05.webp');">
          <span class="metric-number" data-target="5" data-prefix="">0</span>
          <span class="metric-label">Jueces Demo Day</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ───── PREMIOS ───── -->
  <section id="premios" class="hackatob-prizes-section">
    <div class="prizes-container">
      <div class="prizes-header">
        <span class="prizes-eyebrow">PREMIOS</span>
        <h2 class="prizes-title">Trofeos, experiencias y<br>reconocimiento.</h2>
      </div>
      <div class="prizes-grid">
        <!-- Segundo Lugar -->
        <div class="prize-card-container">
          <div class="prize-card-inner prize-second">
            <div class="prize-card-front">
              <div class="prize-medal-wrapper">
                <div class="prize-medal medal-silver"><span class="medal-num">2</span></div>
              </div>
              <span class="prize-rank">SEGUNDO LUGAR</span>
              <h3 class="prize-amount">Premio Plata</h3>
              <p class="prize-desc">Reconocimiento oficial y trofeo conmemorativo para el segundo lugar del Demo Day.</p>
              <div class="prize-flip-hint">
                <span>Ver detalles</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
            </div>
            <div class="prize-card-back">
              <span class="prize-rank">BENEFICIOS 2° LUGAR</span>
              <h4 class="prize-back-title">Premio Plata</h4>
              <ul class="prize-back-list">
                <li>Trofeo conmemorativo Top 3</li>
                <li>Exposición en la página oficial</li>
                <li>Magneto + Certificado de participación</li>
                <li>Acceso a workshops y mentorías</li>
              </ul>
              <div class="prize-flip-hint">
                <span>Volver al frente</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Primer Lugar -->
        <div class="prize-card-container">
          <div class="prize-card-inner prize-first">
            <div class="prize-card-front">
              <div class="prize-medal-wrapper">
                <div class="prize-medal medal-gold"><span class="medal-num">1</span></div>
              </div>
              <span class="prize-rank">PRIMER LUGAR</span>
              <h3 class="prize-amount">Rainforest Adventures</h3>
              <p class="prize-desc">2 entradas dobles a Rainforest Adventures (canopy o teleférico) + trofeos de campeones.</p>
              <div class="prize-flip-hint">
                <span>Ver detalles</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
            </div>
            <div class="prize-card-back">
              <span class="prize-rank">BENEFICIOS 1° LUGAR</span>
              <h4 class="prize-back-title">Gran Ganador ToB</h4>
              <ul class="prize-back-list">
                <li>2 Entradas dobles a Rainforest Adventures</li>
                <li>Trofeos individuales de Campeones</li>
                <li>Exposición destacada de proyecto</li>
                <li>Formación y mentoría exclusiva WWT</li>
                <li>Magneto + Certificado de participación</li>
              </ul>
              <div class="prize-flip-hint">
                <span>Volver al frente</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Tercer Lugar -->
        <div class="prize-card-container">
          <div class="prize-card-inner prize-third">
            <div class="prize-card-front">
              <div class="prize-medal-wrapper">
                <div class="prize-medal medal-bronze"><span class="medal-num">3</span></div>
              </div>
              <span class="prize-rank">TERCER LUGAR</span>
              <h3 class="prize-amount">Premio Bronce</h3>
              <p class="prize-desc">Reconocimiento oficial y trofeo conmemorativo para el tercer lugar del Demo Day.</p>
              <div class="prize-flip-hint">
                <span>Ver detalles</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
            </div>
            <div class="prize-card-back">
              <span class="prize-rank">BENEFICIOS 3° LUGAR</span>
              <h4 class="prize-back-title">Premio Bronce</h4>
              <ul class="prize-back-list">
                <li>Trofeo conmemorativo Top 3</li>
                <li>Exposición en la página oficial</li>
                <li>Magneto + Certificado de participación</li>
                <li>Acceso a workshops y formación</li>
              </ul>
              <div class="prize-flip-hint">
                <span>Volver al frente</span>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───── MARQUEE DIVISOR ───── -->
  <div class="divider-marquee hackatob-divider-marquee">
    <div class="marquee-stripe marquee-1">
      <div class="marquee-track track-left">
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
      </div>
    </div>
    <div class="marquee-stripe marquee-2">
      <div class="marquee-track track-right">
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
        <span class="marquee-text">HACKATOB <span class="text-cyan">✦</span> FUTURO <span class="text-cyan">✦</span> EMPRENDIMIENTO <span class="text-cyan">✦</span> IMPACTO <span class="text-cyan">✦</span> COMPETENCIA <span class="text-cyan">✦</span> APRENDIZAJE <span class="text-cyan">✦</span> </span>
      </div>
    </div>
  </div>

  <!-- ───── TRACKS ───── -->
  <section id="tracks" class="hackatob-tracks-section">
    <div class="tracks-container">
      <div class="tracks-header">
        <span class="tracks-eyebrow">TEMAS</span>
        <h2 class="tracks-title">Tres tracks. Tres Sparks.</h2>
      </div>
      <div class="tracks-grid">
        <!-- Track 1: GreenTrack -->
        <a href="https://www.bbva.com/es/sostenibilidad/inteligencia-artificial-y-sostenibilidad-casos-de-exito-y-soluciones-reales/" target="_blank" rel="noopener noreferrer" class="track-card track-green">
          <div class="track-hover-bg" style="background-image: url('/imagenes/hackatob/track01.webp');"></div>
          <div class="track-hover-overlay"></div>
          <div class="track-card-image">
            <img src="/imagenes/hackatob/spark-green.png" alt="Spark GreenTrack" class="track-spark-img">
          </div>
          <div class="track-card-content">
            <span class="track-tag">GT · GreenTrack</span>
            <h3 class="track-name">GreenTrack</h3>
            <h4 class="track-punchline">Innovación para un futuro sostenible</h4>
            <p class="track-desc">Soluciones ambientales relacionadas con sostenibilidad, agricultura, residuos, comunidades y recursos naturales.</p>
            <div class="track-badges">
              <span class="track-badge">Biodiversidad</span>
              <span class="track-badge">Agua</span>
              <span class="track-badge">Energía</span>
              <span class="track-badge">Residuos</span>
              <span class="track-badge">Economía circular</span>
            </div>
          </div>
        </a>

        <!-- Track 2: FinTrack -->
        <a href="https://es.weforum.org/stories/2025/12/asi-es-la-nueva-frontera-de-la-inclusion-financiera-impulsada-por-la-ia/" target="_blank" rel="noopener noreferrer" class="track-card track-orange">
          <div class="track-hover-bg" style="background-image: url('/imagenes/hackatob/track02.webp');"></div>
          <div class="track-hover-overlay"></div>
          <div class="track-card-image">
            <img src="/imagenes/hackatob/spark-fin.png" alt="Spark FinTrack" class="track-spark-img">
          </div>
          <div class="track-card-content">
            <span class="track-tag">FT · FinTrack</span>
            <h3 class="track-name">FinTrack</h3>
            <h4 class="track-punchline">Soluciones para una economía más accesible</h4>
            <p class="track-desc">Soluciones financieras, fintech, transparencia, educación e inclusión económica.</p>
            <div class="track-badges">
              <span class="track-badge">Inclusión</span>
              <span class="track-badge">Pagos</span>
              <span class="track-badge">Pymes</span>
              <span class="track-badge">Educación financiera</span>
              <span class="track-badge">Ciberseguridad</span>
            </div>
          </div>
        </a>

        <!-- Track 3: The Next Big Thing -->
        <a href="https://fi.co/insight/the-solocorn-phenomenon-is-happening-now" target="_blank" rel="noopener noreferrer" class="track-card track-purple">
          <div class="track-hover-bg" style="background-image: url('/imagenes/hackatob/track03.webp');"></div>
          <div class="track-hover-overlay"></div>
          <div class="track-card-image">
            <img src="/imagenes/hackatob/estrella.png" alt="Spark The Next Big Thing" class="track-spark-img">
          </div>
          <div class="track-card-content">
            <span class="track-tag">TNBT · The Next Big Thing</span>
            <h3 class="track-name">The Next Big Thing</h3>
            <h4 class="track-punchline">Construye lo que todavía no existe</h4>
            <p class="track-desc">Soluciones abiertas con alto potencial de impacto, crecimiento o disrupción.</p>
            <div class="track-badges">
              <span class="track-badge">IA</span>
              <span class="track-badge">Automatización</span>
              <span class="track-badge">Blockchain</span>
              <span class="track-badge">Nuevos modelos</span>
              <span class="track-badge">Alto crecimiento</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ───── SEDES ───── -->
  <section id="sedes" class="hackatob-sedes-section">
    <div class="sedes-container">
      <div class="sedes-header">
        <span class="sedes-eyebrow">DÓNDE OCURRE</span>
        <h2 class="sedes-title">EmprendeLab.</h2>
      </div>
      <div class="sedes-grid single-sede">
        <div class="sede-card">
          <div class="sede-img-wrapper">
            <img src="/imagenes/hackatob/emprende.webp" alt="EmprendeLab" class="sede-img">
          </div>
          <div class="sede-body">
            <h3 class="sede-name">EmprendeLab</h3>
            <p class="sede-role-tag">Sede Oficial · TEC Cartago</p>
            <div class="sede-badges">
              <span class="sede-badge">Día 1</span>
              <span class="sede-badge">Día 2</span>
              <span class="sede-badge">Día 3</span>
              <span class="sede-badge">Día 4</span>
            </div>
            <a href="https://www.google.com/maps/place/TEC+Emprende+Lab/" target="_blank" rel="noopener noreferrer" class="sede-maps-btn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Cómo llegar</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───── AGENDA PREVIEW ───── -->
  <section id="agenda-preview" class="hackatob-schedule-preview-section">
    <div class="hackatob-section-header">
      <h2 class="hackatob-section-title">Programa &amp; <span class="text-cyan">Agenda</span></h2>
      <p class="hackatob-section-subtitle">Descubre el cronograma completo día por día, workshops, mentorías y entregables.</p>
    </div>
    <div class="agenda-preview-card">
      <div class="agenda-preview-glow"></div>
      <div class="agenda-preview-days-grid">
        <div class="agenda-mini-day">
          <span class="mini-day-pill">Día 1</span>
          <h4>Día 1: PreHackaToB</h4>
          <p>Ideación, retos y formación de equipos en EmprendeLab.</p>
        </div>
        <div class="agenda-mini-day">
          <span class="mini-day-pill">Día 2</span>
          <h4>Día 2: Dev Day I</h4>
          <p>Desarrollo técnico, arquitectura y mentorías especializadas.</p>
        </div>
        <div class="agenda-mini-day">
          <span class="mini-day-pill">Día 3</span>
          <h4>Día 3: Dev Day II</h4>
          <p>Prototipado final, validación y entrega digital 23:59.</p>
        </div>
        <div class="agenda-mini-day highlight-gold">
          <span class="mini-day-pill gold-pill">Día 4</span>
          <h4>Día 4: Demo Day</h4>
          <p>Pitches ante jurado, evaluación en vivo y premiación.</p>
        </div>
      </div>
      <div class="agenda-preview-cta">
        <a href="/programa" class="btn btn-gold-agenda">
          <span>Ver Programa del Evento</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ───── SPONSORS / PARTNERS ───── -->
  <section id="sponsors" class="sponsors-section hackatob-sponsors-section">
    <h3 class="main-sponsors-title">Partners HackaToB</h3>
    <div class="hackatob-platform-badge-container">
      <span class="platform-label">Plataforma del hackathon:</span>
      <a href="https://techrebel.io/" target="_blank" rel="noopener noreferrer" class="techrebel-badge-btn">
        <span>TechRebel</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>
    <div class="sponsors-marquee-wrapper">
      <div class="sponsors-marquee marquee-left">
        <div class="sponsors-track">
