---
import { Navbar } from '../components/Navbar.tsx';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  hideNavbar?: boolean;
  hideFooter?: boolean;
  title?: string;
  description?: string;
  favicon?: string;
}

const {
  hideNavbar = false,
  hideFooter = false,
  title = 'ToB – Technology On Business',
  description = 'El congreso de tecnología y negocios más grande de Costa Rica.',
  favicon = '/imagenes/Miniatura/Miniatura.webp'
} = Astro.props;

const faviconType = favicon.endsWith('.svg')
  ? 'image/svg+xml'
  : favicon.endsWith('.png')
    ? 'image/png'
    : favicon.endsWith('.ico')
      ? 'image/x-icon'
      : 'image/webp';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type={faviconType} href={favicon} />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <!-- Fuentes: conexión adelantada y hoja que no bloquea el renderizado (se aplica al cargar) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" /></noscript>
  <!-- i18n: load synchronously so translations are available at DOMContentLoaded -->
  <script is:inline>
    (function(){
      var s = document.createElement('script');
      s.src = '/lang.js';
      s.async = false;
      document.head.appendChild(s);
    })();
  </script>
</head>
<body>
  {!hideNavbar && <Navbar client:load />}
  <slot />
  {!hideFooter && <Footer />}
</body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
