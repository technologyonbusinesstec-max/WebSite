---
import { Navbar } from '../components/Navbar.tsx';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  hideNavbar?: boolean;
  hideFooter?: boolean;
  title?: string;
  description?: string;
  favicon?: string;
}

const {
  hideNavbar = false,
  hideFooter = false,
  title = 'ToB – Technology On Business',
  description = 'El congreso de tecnología y negocios más grande de Costa Rica.',
  favicon = '/imagenes/Miniatura/Miniatura.webp'
} = Astro.props;

// Google Analytics 4 (propiedad del ToB). Mide todas las páginas, también las de HackaToB (usan este layout).
const GA_ID = 'G-LSJ8H5356N';

const faviconType = favicon.endsWith('.svg')
  ? 'image/svg+xml'
  : favicon.endsWith('.png')
    ? 'image/png'
    : favicon.endsWith('.ico')
      ? 'image/x-icon'
      : 'image/webp';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type={faviconType} href={favicon} />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <!-- Fuentes: conexión adelantada y hoja que no bloquea el renderizado (se aplica al cargar) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" /></noscript>
  <!-- i18n: load synchronously so translations are available at DOMContentLoaded -->
  <script is:inline>
    (function(){
      var s = document.createElement('script');
      s.src = '/lang.js';
      s.async = false;
      document.head.appendChild(s);
    })();
  </script>
  <!-- Google Analytics: lo carga Partytown en un web worker, así no frena la carga ni el scroll.
       No mide en local ni en las vistas previas de Vercel (*.vercel.app), solo en el dominio real. -->
  <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  <script is:inline type="text/partytown" define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    if (/^(localhost|127\.|192\.168\.|10\.)|\.vercel\.app$/.test(location.hostname)) window['ga-disable-' + GA_ID] = true;
    gtag('js', new Date());
    gtag('config', GA_ID);
  </script>
  <!-- Eventos propios: cualquier enlace o botón con data-ga-event="nombre" (y data-ga-label opcional)
       manda ese evento al tocarlo; también el cambio de idioma. -->
  <script is:inline>
    (function () {
      var send = function (name, params) { if (typeof window.gtag === 'function') window.gtag('event', name, params || {}); };
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-ga-event]');
        if (el) send(el.getAttribute('data-ga-event'), { label: el.getAttribute('data-ga-label') || undefined, link_url: el.href || undefined });
      }, true);
      // lang.js también avisa al cargar la página: solo cuenta cuando el idioma de verdad cambia
      var lang = null;
      window.addEventListener('languageChanged', function (e) {
        var next = e.detail && e.detail.lang;
        if (lang && next && next !== lang) send('cambio_idioma', { idioma: next });
        lang = next || lang;
      });
    })();
  </script>
</head>
<body>
  {!hideNavbar && <Navbar client:load />}
  <slot />
  {!hideFooter && <Footer />}
</body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
