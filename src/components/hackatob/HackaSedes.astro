---
// src/components/hackatob/HackaSedes.astro
// Sedes presenciales del HackaToB, en la etapa de la Tierra: dos tarjetas (foto, nombre y "Cómo llegar"
// con su ubicación en Google Maps). Aparecen al llegar al final del recorrido, cuando la Tierra ya se
// acercó a Costa Rica; en escritorio quedan abajo a la izquierda (el pin está a la derecha) y en móvil arriba.
// Sin JavaScript se ven siempre.

const sedes = [
  {
    key: 'emprende',
    name: 'EmprendeLab',
    place: 'TEC, Cartago',
    photo: '/imagenes/hackatob/emprende.webp',
    photoPos: '28% 60%', // la foto trae el logo a la derecha: se encuadra el edificio
    maps: 'https://www.google.com/maps/place/TEC+Emprende+Lab/data=!4m2!3m1!1s0x0:0x2b238fc808172fb5',
  },
  {
    key: 'cic',
    name: 'Auditorio del CIC',
    place: 'TEC, Cartago',
    photo: '/imagenes/hackatob/auditorio.webp',
    photoPos: '50% 40%',
    maps: 'https://www.google.com/maps/place/Centro+de+Investigaci%C3%B3n+en+Computaci%C3%B3n/data=!4m2!3m1!1s0x0:0xcba4895531bd6541',
  },
];
---

<div class="hk-sd" id="hkSedes">
  <div class="hk-sd-panel">
    <p class="hk-sd-eyebrow" data-i18n="hack_sd_eyebrow">Sedes presenciales</p>
    <ul class="hk-sd-cards">
      {sedes.map((s) => (
        <li class="hk-sd-card">
          <img class="hk-sd-photo" src={s.photo} alt="" loading="lazy" decoding="async" style={`object-position: ${s.photoPos}`} />
          <div class="hk-sd-body">
            <div>
              <h3 class="hk-sd-name" data-i18n={`hack_sd_${s.key}_name`}>{s.name}</h3>
              <p class="hk-sd-place">{s.place}</p>
            </div>
            <a class="hk-sd-btn" href={s.maps} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z" /><circle cx="12" cy="9.8" r="2.3" />
              </svg>
              <span data-i18n="hack_sede_maps">Cómo llegar</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <!-- tramo final de la etapa: cuando entra en pantalla, aparecen las tarjetas -->
  <div class="hk-sd-sentinel" aria-hidden="true"></div>
</div>

<script>
  // Aparecen (y se van al subir) según el tramo final de la etapa de la Tierra.
  const sd = document.getElementById('hkSedes');
  const sentinel = sd?.querySelector('.hk-sd-sentinel');
  if (sd && sentinel && 'IntersectionObserver' in window) {
    sd.classList.add('is-armed');
    const onChange: IntersectionObserverCallback = ([entry]) => sd.classList.toggle('is-shown', entry.isIntersecting);
    // root: document → mide contra esta ventana aunque la página esté dentro de un iframe
    let io: IntersectionObserver;
    try {
      io = new IntersectionObserver(onChange, { root: document });
    } catch {
      io = new IntersectionObserver(onChange);
    }
    io.observe(sentinel);
  }
</script>

<style>
  .hk-sd {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 clamp(16px, calc(6vw / var(--hk-z, 1)), 96px) calc(18vh / var(--hk-z, 1));
  }

  /* fija abajo mientras dura la etapa; se ve solo con .is-shown */
  .hk-sd-panel {
    position: sticky;
    bottom: calc(18vh / var(--hk-z, 1)); /* por encima de la cuenta regresiva fija */
    z-index: 1;
    width: min(100%, 640px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .hk-sd.is-armed:not(.is-shown) .hk-sd-panel {
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
  }

  .hk-sd-sentinel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(55vh / var(--hk-z, 1));
    pointer-events: none;
    visibility: hidden;
  }

  .hk-sd-eyebrow {
    margin: 0 0 12px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #cfe0ff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
  }

  .hk-sd-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* tarjeta de vidrio, como el resto de la página */
  .hk-sd-card {
    overflow: hidden;
    border: 1px solid rgba(190, 210, 255, 0.26);
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02) 45%), rgba(6, 10, 26, 0.62);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    backdrop-filter: blur(12px) saturate(1.3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .hk-sd-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hk-sd-body {
    padding: 14px 16px 16px;
  }

  .hk-sd-name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
  }

  .hk-sd-place {
    margin: 4px 0 0;
    font-size: 0.9rem;
    color: rgba(226, 229, 238, 0.75);
  }

  .hk-sd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding: 9px 16px;
    border-radius: 999px;
    background: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: #0b0d14;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .hk-sd-btn:hover {
    background: #dbe6f7;
    transform: translateY(-2px);
  }

  .hk-sd-btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  /* Escritorio: las dos tarjetas grandes, centradas: 65 % del espacio entre el navbar y la cuenta regresiva */
  @media (min-width: 701px) {
    .hk-sd-panel {
      --sd-scale: 0.65;
      display: flex;
      flex-direction: column;
      align-self: center;
      width: calc(100% * var(--sd-scale));
      height: calc((100vh / var(--hk-z, 1) - 96px - 18vh / var(--hk-z, 1)) * var(--sd-scale));
    }

    .hk-sd-cards {
      flex: 1;
      min-height: 0;
      gap: 24px;
    }

    .hk-sd-card {
      display: flex;
      flex-direction: column;
    }

    .hk-sd-photo {
      flex: 1;
      min-height: 0;
      aspect-ratio: auto;
    }

    .hk-sd-body {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 6px 16px;
      padding: 18px 22px;
    }

    .hk-sd-name {
      font-size: 1.6rem;
    }

    .hk-sd-btn {
      margin-top: 0;
    }
  }

  /* Móvil: el pin queda abajo al centro → las tarjetas van arriba, compactas (foto a la izquierda) */
  @media (max-width: 700px) {
    .hk-sd {
      justify-content: flex-start;
      padding: 0 16px;
    }

    .hk-sd-panel {
      top: 76px;
      bottom: auto;
      width: 100%;
    }

    .hk-sd-cards {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .hk-sd-card {
      display: grid;
      grid-template-columns: 112px 1fr;
    }

    .hk-sd-photo {
      height: 100%;
      aspect-ratio: auto;
    }

    .hk-sd-body {
      padding: 10px 12px 12px;
    }

    .hk-sd-name {
      font-size: 1.05rem;
    }

    .hk-sd-btn {
      margin-top: 8px;
      padding: 7px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-sd-panel {
      transition: none;
    }
  }
</style>
