---
// src/components/hackatob/HackaNavbar.astro
// Barra de navegación del HackaToB: botones azules (sin cambios respecto al menú anterior),
// logo, pastilla central de enlaces y pastilla de idioma con estilo Liquid Glass.
// Usa anime.js (cargado desde cdnjs por BigBangBackground) para las píldoras deslizantes;
// si no está disponible, las píldoras se posicionan sin animación.

const links = [
  { href: '#premios', label: 'Premios' },
  { href: '#tracks', label: 'Tracks' },
  { href: '#sedes', label: 'Sedes' },
  { href: '#agenda-preview', label: 'Agenda' },
  { href: '#mentores', label: 'Mentores' },
  { href: '#sponsors', label: 'Sponsors' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="hk-nav" id="hkNav">
  <div class="hk-nav-left">
    <a href="/" class="hack-back-btn" aria-label="Volver al ToB">
      <span class="hk-nav-back-full">&larr; Volver al ToB</span>
      <span class="hk-nav-back-short" aria-hidden="true">&larr; ToB</span>
      <span class="hk-nav-back-icon" aria-hidden="true">&larr;</span>
    </a>
    <!-- RUTA DEL LOGO: cambiar el src si se reemplaza el archivo del logo del HackaToB -->
    <img
        class="hk-nav-logo"
        id="hkNavLogo"
        src="/imagenes/hackatob/hackatob-logo.svg"
        alt="HackaToB"
        height="32"
      decoding="async"
    />
  </div>

  <nav class="hk-nav-pill" id="hkNavPill" aria-label="Secciones del HackaToB">
    <span class="hk-nav-glider" id="hkNavGlider" aria-hidden="true"></span>
    {links.map((l) => (
      <a href={l.href} class="hk-nav-link" data-section={l.href.slice(1)}>{l.label}</a>
    ))}
  </nav>

  <div class="hk-nav-right">
    <button type="button" class="hk-nav-lang" id="hkLangToggle" aria-label="Cambiar idioma">
      <span class="hk-nav-lang-glider" id="hkLangGlider" aria-hidden="true"></span>
      <span class="hk-nav-lang-text active">ES</span>
      <span class="hk-nav-lang-text">EN</span>
    </button>
    <a href="https://techrebel.io/" target="_blank" rel="noopener noreferrer" class="hack-participate-btn">Participar</a>
    <button
      type="button"
      class="hk-nav-menu-btn"
      id="hkMenuToggle"
      aria-label="Menú"
      aria-expanded="false"
      aria-controls="hkNavPanel"
    >
      <span class="hk-nav-burger"></span>
    </button>
  </div>
</header>

<!-- Panel de enlaces para pantallas angostas -->
<nav class="hk-nav-panel" id="hkNavPanel" aria-label="Secciones del HackaToB">
  {links.map((l) => (
    <a href={l.href} class="hk-nav-panel-link" data-section={l.href.slice(1)}>{l.label}</a>
  ))}
</nav>

<script>
  type Anime = (params: Record<string, unknown>) => unknown;
  const anime = (window as unknown as { anime?: Anime & { remove: (t: unknown) => void } }).anime;

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');

  const nav = document.getElementById('hkNav')!;
  const pill = document.getElementById('hkNavPill')!;
  const glider = document.getElementById('hkNavGlider')!;
  const pillLinks = Array.from(pill.querySelectorAll<HTMLAnchorElement>('.hk-nav-link'));
  const panel = document.getElementById('hkNavPanel')!;
  const panelLinks = Array.from(panel.querySelectorAll<HTMLAnchorElement>('.hk-nav-panel-link'));
  const menuBtn = document.getElementById('hkMenuToggle')!;
  const logo = document.getElementById('hkNavLogo') as HTMLImageElement;

  // ─── Logo: placeholder punteado si el archivo no existe ───
  const markMissing = () => logo.classList.add('is-missing');
  logo.addEventListener('error', markMissing);

  // ─── Animación genérica (anime.js o salto instantáneo) ───
  function setStyles(el: HTMLElement, props: Record<string, number>) {
    for (const [k, v] of Object.entries(props)) {
      el.style.setProperty(k, k === 'opacity' ? String(v) : `${v}px`);
    }
  }
  function animate(el: HTMLElement, props: Record<string, number>, duration: number) {
    if (anime) anime.remove(el);
    if (!anime || reduce.matches || duration === 0) return setStyles(el, props);
    anime({ targets: el, ...props, duration, easing: 'easeOutExpo' });
  }

  // ─── Píldora de vidrio deslizante en la pastilla central ───
  const GROW = 0.06; // crece ~6 % por lado para acompañar el zoom del enlace
  function moveGlider(link: HTMLAnchorElement) {
    const w = link.offsetWidth, h = link.offsetHeight;
    const box = {
      left: link.offsetLeft - w * GROW,
      top: link.offsetTop - h * GROW,
      width: w * (1 + GROW * 2),
      height: h * (1 + GROW * 2),
    };
    if (!glider.dataset.visible) {
      // primera aparición: se ubica en el enlace y aparece ahí
      animate(glider, box, 0);
      glider.dataset.visible = '1';
      animate(glider, { opacity: 1 }, 420);
      return;
    }
    animate(glider, { ...box, opacity: 1 }, 420);
  }
  function hideGlider() {
    glider.dataset.visible = '';
    animate(glider, { opacity: 0 }, 420);
  }
  const keyboardFocusInPill = () => pill.querySelector(':focus-visible') !== null;

  pillLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      if (finePointer.matches) moveGlider(link);
    });
    link.addEventListener('focus', () => {
      if (link.matches(':focus-visible')) moveGlider(link);
    });
  });
  pill.addEventListener('mouseleave', () => {
    if (!keyboardFocusInPill()) hideGlider();
  });
  pill.addEventListener('focusout', (e) => {
    if (!pill.contains(e.relatedTarget as Node) && !pill.matches(':hover')) hideGlider();
  });

  // ─── Enlace activo según la sección visible ───
  const sections = pillLinks
    .map((l) => document.getElementById(l.dataset.section!))
    .filter((s): s is HTMLElement => s !== null);
  let activeId = '';
  function setActive(id: string) {
    if (id === activeId) return;
    activeId = id;
    for (const l of [...pillLinks, ...panelLinks]) {
      const on = l.dataset.section === id;
      l.classList.toggle('is-active', on);
      if (on) l.setAttribute('aria-current', 'true');
      else l.removeAttribute('aria-current');
    }
  }
  function updateActive() {
    const line = innerHeight * 0.4;
    let current = '';
    for (const s of sections) {
      const r = s.getBoundingClientRect();
      if (r.top <= line && r.bottom > line) current = s.id;
    }
    setActive(current);
  }

  // ─── Scroll: compactar + sección activa ───
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      nav.classList.toggle('is-compact', scrollY > 40);
      updateActive();
    });
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  onScroll();

  // ─── Menú en pantallas angostas ───
  function setPanel(open: boolean) {
    panel.classList.toggle('open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
  }
  menuBtn.addEventListener('click', () => setPanel(!panel.classList.contains('open')));
  panelLinks.forEach((l) => l.addEventListener('click', () => setPanel(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('open')) {
      setPanel(false);
      menuBtn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    const t = e.target as Node;
    if (panel.classList.contains('open') && !panel.contains(t) && !menuBtn.contains(t)) setPanel(false);
  });

  // ─── Idioma (misma lógica que el menú anterior: alterna el idioma marcado) ───
  const langToggle = document.getElementById('hkLangToggle')!;
  const langGlider = document.getElementById('hkLangGlider')!;
  const langTexts = Array.from(langToggle.querySelectorAll<HTMLElement>('.hk-nav-lang-text'));
  function placeLangGlider(duration: number) {
    const active = langTexts.find((t) => t.classList.contains('active')) ?? langTexts[0];
    animate(langGlider, { left: active.offsetLeft, width: active.offsetWidth }, duration);
  }
  langToggle.addEventListener('click', () => {
    langTexts.forEach((t) => t.classList.toggle('active'));
    placeLangGlider(420);
  });
  placeLangGlider(0);
</script>

<style>
  /* ───── Barra: fija, sin fondo propio ───── */
  .hk-nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 94%;
    max-width: 1260px;
    height: 60px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 0 10px;
    z-index: 1000;
    pointer-events: none;
  }

  .hk-nav > * {
    pointer-events: auto;
  }

  .hk-nav-left,
  .hk-nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hk-nav-left { justify-self: start; }
  .hk-nav-right { justify-self: end; }

  /* ───── Botones azules: idénticos al menú anterior ───── */
  .hack-back-btn {
    background: linear-gradient(135deg, #1e88e5, #1565c0);
    color: #ffffff !important;
    text-decoration: none;
    padding: 8px 22px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 4px 18px rgba(30, 136, 229, 0.45);
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hack-back-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(30, 136, 229, 0.65);
    background: linear-gradient(135deg, #2196f3, #1976d2);
  }

  .hk-nav-back-short,
  .hk-nav-back-icon {
    display: none;
  }

  .hack-participate-btn {
    background: linear-gradient(135deg, #1e88e5, #1565c0);
    color: #ffffff !important;
    text-decoration: none;
    padding: 8px 24px;
    border-radius: 50px;
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 4px 18px rgba(30, 136, 229, 0.45);
    transition: all 0.3s ease;
  }

  .hack-participate-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(30, 136, 229, 0.65);
    background: linear-gradient(135deg, #2196f3, #1976d2);
  }

  /* ───── Logo ───── */
  .hk-nav-logo {
    display: block;
    height: 32px;
    width: auto;
    filter: drop-shadow(0 1px 6px rgba(0, 0, 0, 0.45));
  }

  .hk-nav-logo.is-missing {
    width: 96px;
    border: 1px dashed rgba(255, 255, 255, 0.55);
    border-radius: 8px;
    font-size: 11px;
    line-height: 30px;
    text-align: center;
    color: #f2f1fb;
  }

  /* ───── Liquid Glass (base común) ───── */
  .hk-nav-pill,
  .hk-nav-lang,
  .hk-nav-menu-btn,
  .hk-nav-panel {
    background: rgba(255, 255, 255, 0.07);
    -webkit-backdrop-filter: blur(16px) saturate(1.6) brightness(0.7);
    backdrop-filter: blur(16px) saturate(1.6) brightness(0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 8px 30px rgba(0, 0, 0, 0.25);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hk-nav-pill,
    .hk-nav-lang,
    .hk-nav-menu-btn,
    .hk-nav-panel {
      background: rgba(10, 12, 28, 0.82);
    }
  }

  /* ───── Pastilla central ───── */
  .hk-nav-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px;
    border-radius: 999px;
    transition: padding 0.3s ease;
  }

  .hk-nav.is-compact .hk-nav-pill {
    padding: 3px;
  }

  .hk-nav-glider {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    opacity: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 4px 14px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  .hk-nav-link,
  .hk-nav-panel-link {
    position: relative;
    color: #f2f1fb;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6), 0 0 12px rgba(0, 0, 0, 0.35);
    border: 1px solid transparent;
    border-radius: 999px;
  }

  .hk-nav-link {
    padding: 8px 12px;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.4),
      filter 0.3s ease,
      opacity 0.3s ease,
      padding 0.3s ease;
  }

  .hk-nav-link:focus-visible {
    outline: none;
  }

  /* Enlace activo: amarillo del menú anterior dentro de una píldora de vidrio */
  .hk-nav-link.is-active,
  .hk-nav-panel-link.is-active {
    color: #ffd700;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 215, 0, 0.55);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 0 14px rgba(255, 215, 0, 0.18);
  }

  /* Efecto foco (cursor) */
  @media (hover: hover) and (pointer: fine) {
    .hk-nav-pill:has(.hk-nav-link:hover) .hk-nav-link:not(:hover) {
      filter: blur(2.5px);
      opacity: 0.5;
    }
    .hk-nav-link:hover {
      transform: scale(1.12);
    }
  }

  /* Efecto foco (teclado) */
  .hk-nav-pill:has(.hk-nav-link:focus-visible) .hk-nav-link:not(:focus-visible) {
    filter: blur(2.5px);
    opacity: 0.5;
  }
  .hk-nav-link:focus-visible {
    transform: scale(1.12);
  }

  /* ───── Pastilla de idioma ───── */
  .hk-nav-lang {
    position: relative;
    display: flex;
    align-items: center;
    padding: 3px;
    height: 36px;
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
  }

  .hk-nav-lang:focus-visible,
  .hk-nav-menu-btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: 3px;
  }

  .hk-nav-lang-glider {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: 34px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45), 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .hk-nav-lang-text {
    position: relative;
    width: 34px;
    text-align: center;
    color: #f2f1fb;
    font-size: 14px;
    font-weight: 500;
    line-height: 28px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6), 0 0 12px rgba(0, 0, 0, 0.35);
    opacity: 0.7;
    user-select: none;
    transition: opacity 0.3s ease;
  }

  .hk-nav-lang-text.active {
    opacity: 1;
  }

  /* ───── Botón de menú y panel (pantallas angostas) ───── */
  .hk-nav-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    cursor: pointer;
    place-items: center;
    padding: 0;
  }

  .hk-nav-burger,
  .hk-nav-burger::before,
  .hk-nav-burger::after {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: #f2f1fb;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hk-nav-burger {
    position: relative;
  }

  .hk-nav-burger::before,
  .hk-nav-burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hk-nav-burger::before { top: -6px; }
  .hk-nav-burger::after { top: 6px; }

  .hk-nav-menu-btn[aria-expanded='true'] .hk-nav-burger { background: transparent; }
  .hk-nav-menu-btn[aria-expanded='true'] .hk-nav-burger::before { transform: translateY(6px) rotate(45deg); }
  .hk-nav-menu-btn[aria-expanded='true'] .hk-nav-burger::after { transform: translateY(-6px) rotate(-45deg); }

  .hk-nav-panel {
    display: none;
    position: fixed;
    top: 90px;
    left: 3%;
    right: 3%;
    z-index: 999;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 24px;
  }

  .hk-nav-panel.open {
    display: flex;
  }

  .hk-nav-panel-link {
    padding: 12px 16px;
    font-size: 16px;
  }

  @media (hover: hover) and (pointer: fine) {
    .hk-nav-panel-link:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }

  .hk-nav-panel-link:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.7);
    outline-offset: -2px;
  }

  /* ───── Responsive ───── */
  /* Pantallas medianas: la pastilla completa no entra junto a los botones */
  @media (max-width: 1240px) {
    .hk-nav { width: calc(100% - 24px); gap: 10px; padding: 0; }
    .hk-nav-left,
    .hk-nav-right { gap: 10px; }
    .hk-nav-back-full { display: none; }
    .hk-nav-back-short { display: inline; }
    .hk-nav-link { padding: 8px 9px; }
  }

  @media (max-width: 899.98px) {
    .hk-nav {
      grid-template-columns: 1fr auto;
      gap: 8px;
    }
    .hk-nav-pill { display: none; }
    .hk-nav-menu-btn { display: grid; }
    .hk-nav-left,
    .hk-nav-right { gap: 8px; }
  }

  @media (max-width: 480px) {
    .hk-nav { width: calc(100% - 24px); padding: 0; top: 14px; }
    .hk-nav-back-short { display: none; }
    .hk-nav-back-icon { display: inline; }
    .hk-nav-panel { top: 82px; }
  }

  @media (max-width: 400px) {
    .hk-nav { width: calc(100% - 16px); gap: 6px; }
    .hk-nav-left,
    .hk-nav-right { gap: 6px; }
    .hk-nav-lang-text,
    .hk-nav-lang-glider { width: 30px; }
  }

  @media (min-width: 900px) {
    .hk-nav-panel { display: none !important; }
  }

  /* ───── Movimiento reducido: cambios instantáneos ───── */
  @media (prefers-reduced-motion: reduce) {
    .hk-nav-pill,
    .hk-nav-link,
    .hk-nav-lang-text,
    .hk-nav-burger,
    .hk-nav-burger::before,
    .hk-nav-burger::after {
      transition: none !important;
    }
    .hk-nav-link:hover,
    .hk-nav-link:focus-visible {
      transform: none !important;
    }
  }
</style>
