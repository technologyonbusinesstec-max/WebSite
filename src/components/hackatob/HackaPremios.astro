  .is-pinned > .hk-pz-sentinel {
    display: block;
    position: absolute;
    left: 0;
    width: 1px;
    top: calc(var(--pz-step-h) * var(--k) + 50vh / var(--hk-z, 1));
    height: var(--pz-step-h);
    pointer-events: none;
