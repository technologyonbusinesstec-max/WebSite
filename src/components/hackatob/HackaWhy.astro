---
// src/components/hackatob/HackaWhy.astro
// Etapa 2 (explosión): por qué participar + botón de inscripción.
// Los textos en inglés van en public/lang.js con las mismas claves.

interface Props {
  ctaHref?: string;
}

const { ctaHref = 'https://techrebel.io/' } = Astro.props;

// RAZONES: editar aquí
const reasons = [
  { key: 'w1', title: 'Construye algo real', text: 'Lleva tu idea a un proyecto y preséntalo ante los jueces en el Demo Day.' },
  { key: 'w2', title: 'Mentores a tu lado', text: 'Mentores de la industria y workshops para destrabar tu proyecto.' },
  { key: 'w3', title: 'Premios y reconocimiento', text: 'Trofeos y experiencias para los tres mejores, y certificado digital para todos.' },
  { key: 'w4', title: 'Encuentra a tu equipo', text: 'No necesitas llegar con equipo: se arman en el PreHackaToB, de hasta 4 personas.' },
];
---

<div class="hk-why" id="hkWhy">
  <p class="hk-why-eyebrow" data-i18n="hack_why_eyebrow">Por qué participar</p>
  <h2 class="hk-why-title" data-i18n="hack_why_title">Cuatro razones para despegar con nosotros</h2>

  <ol class="hk-why-grid">
    {reasons.map((r, i) => (
      <li class="hk-why-card" style={`--i: ${i}`}>
        <span class="hk-why-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 data-i18n={`hack_${r.key}_title`}>{r.title}</h3>
        <p data-i18n={`hack_${r.key}_text`}>{r.text}</p>
      </li>
    ))}
  </ol>

  <a class="hk-why-cta" href={ctaHref} target="_blank" rel="noopener noreferrer" data-i18n="hack_hero_cta">Quiero participar</a>
</div>

<script>
  // Las tarjetas entran escalonadas la primera vez que la sección aparece en pantalla
  const why = document.getElementById('hkWhy');
  if (why && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    why.classList.add('is-waiting');
    const seen = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        why.classList.remove('is-waiting');
        seen.disconnect();
      },
      { threshold: 0.2 },
    );
    seen.observe(why);
  }
</script>

<style>
  .hk-why {
    width: min(100%, 1080px);
    margin-inline: auto;
    text-align: center;
  }

  .hk-why-eyebrow {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ff9a1f;
  }

  .hk-why-title {
    margin: 10px 0 0;
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #fff;
    text-shadow: 0 2px 24px rgba(3, 3, 10, 0.8);
  }

  .hk-why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  /* Fondo oscuro y desenfocado: el texto se lee aunque detrás pase el destello */
  .hk-why-card {
    padding: 20px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(5, 5, 16, 0.62);
    backdrop-filter: blur(10px);
    transition:
      opacity 0.6s ease calc(var(--i) * 90ms),
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 90ms),
      border-color 0.25s ease;
  }

  .hk-why-card:hover {
    border-color: rgba(255, 154, 31, 0.55);
  }

  .hk-why.is-waiting .hk-why-card {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }

  .hk-why-num {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace;
    font-size: 13px;
    color: #ff9a1f;
  }

  .hk-why-card h3 {
    margin: 10px 0 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
  }

  .hk-why-card p {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: #c9c8de;
  }

  .hk-why-cta {
    display: inline-block;
    margin-top: 36px;
    padding: 14px 36px;
    border-radius: 50px;
    background: linear-gradient(135deg, #2347c5, #132a8c);
    box-shadow: 0 4px 22px rgba(26, 55, 166, 0.55);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hk-why-cta:hover,
  .hk-why-cta:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(50, 90, 230, 0.7);
  }

  .hk-why-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 999.98px) {
    .hk-why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .hk-why-grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 24px;
    }

    .hk-why-card {
      padding: 16px;
    }

    .hk-why-cta {
      margin-top: 24px;
    }
  }
</style>
