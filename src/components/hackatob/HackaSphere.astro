---
// src/components/hackatob/HackaSphere.astro
// Esfera de partículas del hero de HackaToB (columna derecha; en móvil, centrada sobre el punto de luz).
// Interacciones:
//   - pasar el mouse: los puntos cercanos se encienden en otro color (HIGHLIGHT) y se apartan un poco, con estela;
//   - tocar o hacer clic sobre la esfera: vibra con una onda que sale del punto tocado;
//   - mantener apretado y arrastrar: rota la esfera (con inercia al soltar).
// Un toque sin arrastre sobre la esfera emite el evento "hackaSphereTap" en window (el hero cambia su frase).
// Usa el three.js global (r128) que ya carga BigBangBackground.astro, para no descargar una segunda copia.
---

<div class="hk-sphere" id="hkSphere" aria-hidden="true">
  <canvas class="hk-sphere-canvas"></canvas>
</div>

<script>
  type ThreeNS = any;

  // ── Ajustes ──
  const SHELL_POINTS = 4200; // puntos sobre la superficie
  const BAND_POINTS = 1600; // franja interior
  const MOBILE_FACTOR = 0.55; // en pantallas táctiles se dibujan menos puntos
  const BASE_COLORS = ['#7d8597', '#a3abbd', '#cfd5e2', '#3b6cf6', '#5b8cff', '#2a4fb8']; // grises y azules
  const BAND_COLORS = ['#5b8cff', '#7fb0ff', '#3b6cf6', '#b9c6e0'];
  const HIGHLIGHT = '#ffd43b'; // color al pasar el mouse (amarillo de marca)
  const HOVER_RADIUS = 80; // px CSS alrededor del cursor
  const AUTO_SPIN = 0.12; // rad/s
  const MAX_RIPPLES = 4;

  // three.js se carga con defer (BigBangBackground): si todavía no está, se espera a que la página
  // termine de leerse, cuando ya corrieron todos los scripts diferidos
  const root = document.getElementById('hkSphere');
  const start = () => {
    const THREE: ThreeNS = (window as any).THREE;
    if (root && THREE) init(root, THREE);
  };
  if ((window as any).THREE) start();
  else if (document.readyState === 'loading') addEventListener('DOMContentLoaded', start, { once: true });
  else addEventListener('load', start, { once: true });

  function init(root: HTMLElement, THREE: ThreeNS) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(pointer: coarse)').matches;

    let renderer: any;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: true, powerPreference: 'low-power' });
    } catch {
      root.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 20);
    camera.position.set(0, 0, 4.2);

    // ── Geometría: cáscara (Fibonacci) + franja interior inclinada ──
    const nShell = Math.round(SHELL_POINTS * (coarse ? MOBILE_FACTOR : 1));
    const nBand = Math.round(BAND_POINTS * (coarse ? MOBILE_FACTOR : 1));
    const n = nShell + nBand;
    const pos = new Float32Array(n * 3);
    const col = new Float32Array(n * 3);
    const size = new Float32Array(n);
    const seed = new Float32Array(n);
    const heat = new Float32Array(n);
    const isShell = new Uint8Array(n);
    const c = new THREE.Color();
    const pick = (list: string[]) => c.set(list[Math.floor(Math.random() * list.length)]);

    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < nShell; i++) {
      const y = 1 - (i / (nShell - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const th = golden * i;
      // un poco de ruido para que no se vea como una malla perfecta
      const j = 1 + (Math.random() - 0.5) * 0.02;
      pos.set([Math.cos(th) * r * j, y * j, Math.sin(th) * r * j], i * 3);
      pick(BASE_COLORS);
      col.set([c.r, c.g, c.b], i * 3);
      size[i] = 0.011 + Math.random() * 0.009;
      seed[i] = Math.random();
      isShell[i] = 1;
    }

    const tilt = new THREE.Euler(0.38, 0, -0.22);
    const v = new THREE.Vector3();
    for (let k = 0; k < nBand; k++) {
      const i = nShell + k;
      // más densa hacia el centro, con grosor que se afina hacia el borde
      const rad = 0.12 + Math.pow(Math.random(), 0.7) * 0.8;
      const a = Math.random() * Math.PI * 2;
      const g = (Math.random() + Math.random() + Math.random() - 1.5) * 0.06 * (1.1 - rad);
      v.set(Math.cos(a) * rad, g, Math.sin(a) * rad).applyEuler(tilt);
      pos.set([v.x, v.y, v.z], i * 3);
      pick(BAND_COLORS);
      col.set([c.r, c.g, c.b], i * 3);
      size[i] = 0.009 + Math.random() * 0.008;
      seed[i] = Math.random();
    }

    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
    geo.setAttribute('aSize', new THREE.BufferAttribute(size, 1));
    geo.setAttribute('aSeed', new THREE.BufferAttribute(seed, 1));
    const heatAttr = new THREE.BufferAttribute(heat, 1);
    heatAttr.setUsage(THREE.DynamicDrawUsage);
    geo.setAttribute('aHeat', heatAttr);

    const ripples = Array.from({ length: MAX_RIPPLES }, () => new THREE.Vector4(0, 0, 1, -100));
    let nextRipple = 0;

    const mat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uScale: { value: 1 },
        uMotion: { value: reduced ? 0 : 1 },
        uCamDist: { value: camera.position.z },
        uHighlight: { value: new THREE.Color(HIGHLIGHT) },
        uRipples: { value: ripples },
      },
      vertexShader: /* glsl */ `
        attribute vec3 aColor;
        attribute float aSize;
        attribute float aSeed;
        attribute float aHeat;
        uniform float uTime;
        uniform float uScale;
        uniform float uMotion;
        uniform float uCamDist;
        uniform vec3 uHighlight;
        uniform vec4 uRipples[${MAX_RIPPLES}];
        varying vec3 vColor;
        varying float vAlpha;

        void main() {
          vec3 n = normalize(position);
          float disp = 0.0;
          for (int i = 0; i < ${MAX_RIPPLES}; i++) {
            float t = uTime - uRipples[i].w;
            if (t > 0.0 && t < 3.0) {
              float d = acos(clamp(dot(n, uRipples[i].xyz), -1.0, 1.0)); // distancia angular al toque
              float reach = 1.0 - smoothstep(t * 3.0 - 0.5, t * 3.0 + 0.25, d); // la onda avanza desde el toque
              float decay = exp(-t * 1.9);
              disp += 0.075 * sin(d * 9.0 - t * 13.0) * reach * decay;
              // zumbido corto: cada punto vibra con su propia fase
              disp += 0.018 * sin(uTime * 70.0 + aSeed * 50.0) * exp(-t * 4.5);
            }
          }
          vec3 p = position + n * (disp + aHeat * 0.07) * uMotion;

          vec4 mv = modelViewMatrix * vec4(p, 1.0);
          gl_Position = projectionMatrix * mv;
          gl_PointSize = max(1.5, aSize * uScale * (1.0 + aHeat * 1.3) / -mv.z);

          // los puntos de atrás se ven más tenues
          float front = smoothstep(-1.1, 1.1, mv.z + uCamDist);
          vColor = mix(aColor, uHighlight, aHeat);
          vAlpha = mix(0.18, 0.95, front) + aHeat * 0.6;
        }
      `,
      fragmentShader: /* glsl */ `
        varying vec3 vColor;
        varying float vAlpha;
        void main() {
          float d = length(gl_PointCoord - 0.5);
          float a = (1.0 - smoothstep(0.15, 0.5, d)) * vAlpha;
          if (a < 0.01) discard;
          gl_FragColor = vec4(vColor, a);
        }
      `,
    });

    const points = new THREE.Points(geo, mat);
    scene.add(points);
    points.rotation.set(0.25, 0, 0);

    // ── Tamaño ──
    let cssW = 1, cssH = 1;
    const resize = () => {
      const r = root.getBoundingClientRect();
      cssW = Math.max(1, r.width);
      cssH = Math.max(1, r.height);
      renderer.setSize(cssW, cssH, false);
      camera.aspect = cssW / cssH;
      camera.updateProjectionMatrix();
      const fov = (camera.fov * Math.PI) / 180;
      mat.uniforms.uScale.value = renderer.getDrawingBufferSize(new THREE.Vector2()).y / (2 * Math.tan(fov / 2));
      needsFrame = true;
    };
    // también da la primera medida, ya con el diseño calculado (medir a mano aquí forzaría un reflow)
    new ResizeObserver(resize).observe(root);

    // ── Puntero: hover, toque (vibración) y arrastre (rotación) ──
    const mouse = { x: 0, y: 0, inside: false };
    const ray = new THREE.Raycaster();
    const sphere = new THREE.Sphere(new THREE.Vector3(), 1);
    const hit = new THREE.Vector3();
    const ndc = new THREE.Vector2();
    const inv = new THREE.Quaternion();

    const hitTest = (clientX: number, clientY: number) => {
      const r = canvas.getBoundingClientRect();
      ndc.set(((clientX - r.left) / r.width) * 2 - 1, -((clientY - r.top) / r.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      return ray.ray.intersectSphere(sphere, hit);
    };

    const vibrate = (clientX: number, clientY: number) => {
      if (!hitTest(clientX, clientY)) return false;
      if (reduced) return true;
      // punto tocado en coordenadas de la esfera (sin su rotación)
      inv.copy(points.quaternion).invert();
      const local = hit.clone().normalize().applyQuaternion(inv);
      ripples[nextRipple].set(local.x, local.y, local.z, clock);
      nextRipple = (nextRipple + 1) % MAX_RIPPLES;
      needsFrame = true;
      return true;
    };

    let dragging = false;
    let lastX = 0, lastY = 0, lastT = 0;
    // toque: apretar sobre la esfera y soltar sin arrastrar → avisa con el evento "hackaSphereTap"
    let downHit = false, downX = 0, downY = 0, downT = 0;
    let velX = 0, velY = 0; // rad/s
    const rotY = new THREE.Quaternion();
    const rotX = new THREE.Quaternion();
    const AXIS_X = new THREE.Vector3(1, 0, 0);
    const AXIS_Y = new THREE.Vector3(0, 1, 0);
    const rotate = (ax: number, ay: number) => {
      rotY.setFromAxisAngle(AXIS_Y, ax);
      rotX.setFromAxisAngle(AXIS_X, ay);
      points.quaternion.premultiply(rotY).premultiply(rotX);
    };

    canvas.addEventListener('pointerdown', (e) => {
      downHit = vibrate(e.clientX, e.clientY);
      downX = e.clientX;
      downY = e.clientY;
      downT = performance.now();
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = performance.now();
      velX = velY = 0;
      canvas.setPointerCapture(e.pointerId);
      root.classList.add('is-dragging');
    });

    canvas.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
      mouse.inside = e.pointerType === 'mouse' || dragging;
      needsFrame = true;
      if (!dragging) {
        root.classList.toggle('is-over', !!hitTest(e.clientX, e.clientY));
        return;
      }
      const now = performance.now();
      const dt = Math.max(1, now - lastT) / 1000;
      const k = 3.2 / Math.max(cssW, cssH); // rad por px
      const ax = (e.clientX - lastX) * k;
      const ay = (e.clientY - lastY) * k * (e.pointerType === 'touch' ? 0 : 1);
      rotate(ax, ay);
      velX = ax / dt;
      velY = ay / dt;
      lastX = e.clientX;
      lastY = e.clientY;
      lastT = now;
    });

    const endDrag = (e: PointerEvent) => {
      const tap = e.type === 'pointerup' && downHit && Math.hypot(e.clientX - downX, e.clientY - downY) < 8 && performance.now() - downT < 500;
      if (tap) window.dispatchEvent(new CustomEvent('hackaSphereTap'));
      downHit = false;
      dragging = false;
      root.classList.remove('is-dragging');
      if (e.pointerType !== 'mouse') mouse.inside = false;
      if (performance.now() - lastT > 80) velX = velY = 0; // soltó quieto: sin inercia
      if (reduced) velX = velY = 0;
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);
    canvas.addEventListener('pointerleave', () => {
      if (!dragging) mouse.inside = false;
      root.classList.remove('is-over');
    });

    // ── Calor de hover (CPU): se proyecta cada punto a pantalla y se compara con el cursor ──
    const m = new THREE.Matrix4();
    const me = m.elements;
    const rot = new THREE.Matrix4();
    const re = rot.elements;
    let hot = false;
    const updateHeat = (dt: number) => {
      if (!mouse.inside && !hot) return;
      points.updateMatrixWorld();
      m.multiplyMatrices(camera.projectionMatrix, camera.matrixWorldInverse).multiply(points.matrixWorld);
      rot.extractRotation(points.matrixWorld);
      const decay = Math.exp(-dt * 2.2);
      const r2 = HOVER_RADIUS * HOVER_RADIUS;
      hot = false;
      for (let i = 0; i < n; i++) {
        let h = heat[i] * decay;
        if (mouse.inside) {
          const x = pos[i * 3], y = pos[i * 3 + 1], z = pos[i * 3 + 2];
          // solo la cara visible de la cáscara reacciona
          const zv = re[2] * x + re[6] * y + re[10] * z;
          if (!isShell[i] || zv > -0.15) {
            const w = me[3] * x + me[7] * y + me[11] * z + me[15];
            const sx = ((me[0] * x + me[4] * y + me[8] * z + me[12]) / w * 0.5 + 0.5) * cssW;
            const sy = (0.5 - (me[1] * x + me[5] * y + me[9] * z + me[13]) / w * 0.5) * cssH;
            const d2 = (sx - mouse.x) ** 2 + (sy - mouse.y) ** 2;
            if (d2 < r2) {
              const f = 1 - Math.sqrt(d2) / HOVER_RADIUS;
              h = Math.max(h, f * f);
            }
          }
        }
        if (h < 0.004) h = 0;
        else hot = true;
        heat[i] = h;
      }
      heatAttr.needsUpdate = true;
    };

    // ── Bucle: solo corre con la esfera en pantalla y la pestaña visible ──
    let visible = true;
    let needsFrame = true;
    let clock = 0;
    let prev = performance.now();
    let raf = 0;

    const frame = (now: number) => {
      raf = 0;
      const dt = Math.min(0.05, (now - prev) / 1000);
      prev = now;
      clock += dt;
      mat.uniforms.uTime.value = clock;

      if (!dragging && !reduced) {
        // la inercia se apaga y vuelve el giro automático
        const f = Math.exp(-dt * 2.5);
        velX = velX * f + AUTO_SPIN * (1 - f);
        velY *= f;
        rotate(velX * dt, velY * dt);
      }
      updateHeat(dt);
      renderer.render(scene, camera);

      const rippling = ripples.some((r) => clock - r.w < 3);
      needsFrame = !reduced || dragging || hot || mouse.inside || rippling;
      schedule();
    };

    const schedule = () => {
      if (!raf && visible && !document.hidden && needsFrame) raf = requestAnimationFrame(frame);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      prev = performance.now();
      schedule();
    }).observe(root);
    document.addEventListener('visibilitychange', () => {
      prev = performance.now();
      schedule();
    });
    canvas.addEventListener('pointermove', schedule);
    canvas.addEventListener('pointerdown', schedule);

    schedule();
  }
</script>

<style>
  .hk-sphere {
    position: absolute;
    top: 50%;
    right: var(--hk-hero-gap);
    width: var(--hk-hero-col);
    max-width: 640px;
    aspect-ratio: 1;
    transform: translateY(-50%);
    z-index: 1;
  }

  .hk-sphere-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: default;
    /* en táctil: el arrastre horizontal rota la esfera y el vertical sigue desplazando la página */
    touch-action: pan-y;
  }

  .hk-sphere.is-over .hk-sphere-canvas {
    cursor: grab;
  }

  .hk-sphere.is-dragging .hk-sphere-canvas {
    cursor: grabbing;
  }

  /* Móvil: sin columna libre, la esfera se centra sobre el punto de luz del fondo */
  @media (max-width: 700px) {
    .hk-sphere {
      right: auto;
      left: 50%;
      width: min(calc(92vw / var(--hk-z, 1)), 420px);
      transform: translate(-50%, -50%);
    }
  }
</style>
