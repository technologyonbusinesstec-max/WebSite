---
// src/components/hackatob/HackaFooter.astro
// Footer del HackaToB: tarjeta redondeada sobre una zona de fondo sólido.
// Con earthFade deja una pausa y un desvanecido encima, para la página del fondo Big Bang
// (la Tierra se desvanece antes de llegar a la tarjeta).
// Los enlaces de "Explorar" salen de la misma lista que usa el navbar, y los textos pasan por
// el sistema de traducción del sitio (data-i18n + public/lang.js).
import { hackatobLinks, withBase, type NavLink } from './navLinks';

interface Props {
  links?: NavLink[];
  /** Ruta de la página que contiene las secciones (p. ej. '/hackatob'); vacía si es la página actual */
  basePath?: string;
  /** Pausa + desvanecido sobre el fondo interactivo, antes del footer */
  earthFade?: boolean;
  logoSrc?: string;
  logoAlt?: string;
}

const {
  links = hackatobLinks,
  basePath = '',
  earthFade = false,
  logoSrc = '/imagenes/hackatob/hackatob-logo.svg',
  logoAlt = 'HackaToB',
} = Astro.props;

// Redes del ToB (las mismas de src/components/Footer.astro) + WhatsApp del HackaToB
const socials = [
  {
    label: 'Facebook del ToB',
    href: 'https://www.facebook.com/CongresoTOB',
    path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
  },
  {
    label: 'Instagram del ToB',
    href: 'https://www.instagram.com/tob.tec/',
    path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
  },
  {
    label: 'WhatsApp del HackaToB',
    // Mensaje prellenado: se edita en el parámetro text
    href: `https://wa.me/50687024840?text=${encodeURIComponent('¡Hola! Vengo de la página web y quiero más información sobre el HackaToB.')}`,
    path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z',
  },
  {
    label: 'LinkedIn del ToB',
    href: 'https://www.linkedin.com/company/technology-on-business/home/',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];
---

<div class="hk-footer-zone">
  {earthFade && <div class="hk-footer-hold" aria-hidden="true" />}
  <!-- fade-curtain (src/styles/fade-curtain.css): la Tierra se desvanece y desenfoca hacia el fondo sólido -->
  <div class:list={['hk-footer-body', { 'fade-curtain': earthFade }]}>
    <footer class="hk-footer">
      <div class="hk-footer-top">
        <div class="hk-footer-brand">
          <img class="hk-footer-logo" src={logoSrc} alt={logoAlt} width="56" height="56" loading="lazy" decoding="async" />
          <p class="hk-footer-tagline" data-i18n="hack_footer_desc">El Hackathon oficial del congreso Technology on Business.</p>
        </div>
        <ul class="hk-footer-social">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={s.path} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="hk-footer-explore" aria-labelledby="hkFooterExplore">
        <h2 class="hk-footer-title" id="hkFooterExplore" data-i18n="hack_footer_explore">Explorar</h2>
        <ul class="hk-footer-links">
          {links.map((l) => (
            <li>
              <a href={withBase(l.href, basePath)} class:list={{ 'is-featured': l.featured }} data-i18n={l.i18n}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="hk-footer-contact" aria-labelledby="hkFooterContact">
        <h2 class="hk-footer-title" id="hkFooterContact" data-i18n="footer_contact">Contacto</h2>
        <ul class="hk-footer-contact-list">
          <li><a href="mailto:administracion@tobcr.com">administracion@tobcr.com</a></li>
          <li><a href="tel:+50670880176">+506 7088 0176</a></li>
          <li><address data-i18n="hack_footer_address">Centro de las Artes,<br />TEC, Cartago</address></li>
        </ul>
      </section>

      <div class="hk-footer-bottom">
        <p class="hk-footer-legal" data-i18n="hack_footer_legal">&copy; 2026 HackaToB. Organizado por estudiantes de ATI del Tecnológico de Costa Rica (TEC).</p>
        <div class="hk-footer-actions">
        <button type="button" class="hk-footer-lang" id="hkFooterLang">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
          </svg>
          <span data-i18n="hack_footer_lang_btn">English</span>
        </button>
        <button type="button" class="hk-footer-top-btn" id="hkFooterTop" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 19V5M5 12l7-7 7 7" />
          </svg>
        </button>
        </div>
      </div>
    </footer>
  </div>
</div>

<script>
  // Mismo cambio de idioma del sitio: setLanguage de public/lang.js (guarda 'tob_lang')
  document.getElementById('hkFooterLang')!.addEventListener('click', () => {
    const setLanguage = (window as unknown as { setLanguage?: (lang: string) => void }).setLanguage;
    const current = localStorage.getItem('tob_lang') || 'es';
    setLanguage?.(current === 'es' ? 'en' : 'es');
  });

  // Volver al inicio de la página
  document.getElementById('hkFooterTop')!.addEventListener('click', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
</script>

<style>
  /* ───── Zona del footer: tapa el fondo interactivo ───── */
  .hk-footer-zone {
    position: relative;
    z-index: 1;
  }

  /* Pausa: la Tierra y la ubicación quedan a la vista antes de que suba el footer.
     La cortina (.fade-curtain) del cuerpo se asoma sobre el tramo final de esta pausa. */
  .hk-footer-hold {
    height: calc(65vh / var(--hk-z, 1));
  }

  .hk-footer-body {
    padding: 40px 24px 48px;
    background:
      radial-gradient(ellipse 70% 55% at 50% 100%, rgba(35, 71, 197, 0.2), transparent 70%),
      #03030a;
  }

  /* ───── Tarjeta ───── */
  .hk-footer {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.03);
    color: #ecebf7;
  }

  .hk-footer ul {
    list-style: none;
  }

  /* ───── Fila superior ───── */
  .hk-footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* Logo y tagline en una misma línea para que la tarjeta sea baja */
  .hk-footer-brand {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hk-footer-logo {
    flex: none;
    display: block;
    width: 56px;
    height: 56px;
  }

  .hk-footer-tagline {
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(236, 235, 247, 0.7);
  }

  .hk-footer-social {
    display: flex;
    gap: 12px;
  }

  .hk-footer-social a {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .hk-footer-social svg {
    width: 18px;
    height: 18px;
  }

  .hk-footer-social a:hover,
  .hk-footer-social a:focus-visible {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #2347c5, #132a8c);
    border-color: transparent;
    box-shadow: 0 4px 18px rgba(26, 55, 166, 0.5);
  }

  /* ───── Explorar ───── */
  .hk-footer-explore,
  .hk-footer-contact {
    margin-top: 20px;
  }

  /* ───── Contacto ───── */
  .hk-footer-contact-list {
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 48px;
  }

  .hk-footer-contact-list address {
    font-style: normal;
    font-size: 15px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8);
  }

  .hk-footer-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(236, 235, 247, 0.55);
  }

  .hk-footer-links {
    margin-top: 4px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px 24px;
  }

  .hk-footer-links a,
  .hk-footer-contact-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.3s ease;
  }

  .hk-footer-links a.is-featured {
    color: #ffd43b;
  }

  .hk-footer-links a:hover,
  .hk-footer-links a:focus-visible,
  .hk-footer-contact-list a:hover,
  .hk-footer-contact-list a:focus-visible {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hk-footer-links a.is-featured:hover,
  .hk-footer-links a.is-featured:focus-visible {
    color: #ffe27a;
  }

  /* ───── Fila inferior ───── */
  .hk-footer-bottom {
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .hk-footer-legal {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(236, 235, 247, 0.6);
  }

  .hk-footer-actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hk-footer-top-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    cursor: pointer;
    transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .hk-footer-top-btn svg {
    width: 20px;
    height: 20px;
  }

  .hk-footer-top-btn:hover,
  .hk-footer-top-btn:focus-visible {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #2347c5, #132a8c);
    border-color: transparent;
    box-shadow: 0 4px 18px rgba(26, 55, 166, 0.5);
  }

  .hk-footer-top-btn:focus-visible,
  .hk-footer-contact-list a:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 3px;
  }

  .hk-footer-lang {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .hk-footer-lang svg {
    width: 18px;
    height: 18px;
  }

  .hk-footer-lang:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .hk-footer-social a:focus-visible,
  .hk-footer-links a:focus-visible,
  .hk-footer-lang:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.85);
    outline-offset: 3px;
  }

  /* ───── Responsive ───── */
  /* Deja espacio para la barra inferior de tabs del navbar */
  @media (max-width: 899.98px) {
    .hk-footer-body { padding: 32px 16px 120px; }
  }

  @media (max-width: 700px) {
    .hk-footer { padding: 28px 22px; border-radius: 24px; }
    .hk-footer-top,
    .hk-footer-bottom,
    .hk-footer-brand {
      flex-direction: column;
      align-items: flex-start;
    }
    .hk-footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-footer-social a,
    .hk-footer-links a,
    .hk-footer-lang {
      transition: none;
    }
    .hk-footer-social a:hover,
    .hk-footer-social a:focus-visible {
      transform: none;
    }
  }
</style>
